--  This is the default version of the target_options.gpr file,
--  imported by runtime_build.gpr / ravenscar_build.gpr. Variables defined
--  here are appended to the corresponding variables there.
--
--  Copied, not reinvented: this is the same file the shipped
--  gnat_riscv64_elf 15.1.2 light-tasking-polarfiresoc runtime uses
--  (read from the installed toolchain), so this leaf's compiler switches
--  match the vendor runtime's own conventions rather than guessing at
--  them.
--
--  Extended along the lines of avrada_rts's avr_tool_options.gpr: this
--  project, not runtime.xml, is the single place the target ISA is
--  decided, and it exports a Builder package for applications to
--  rename. See CONTRACT.md §3.6.

with "gnat_config/light_tasking_mpfs_config.gpr";

abstract project Target_Options is

   type Build_Type is ("Production", "Debug", "Assert", "Gnatcov");
   Build : Build_Type := external ("BUILD", "Production");

   --  COMFLAGS here is common flags (used for C and Ada).
   COMFLAGS := ("-ffunction-sections",
                "-fdata-sections",
                "-fcallgraph-info=su,da");
   COMGNARLFLAGS := ("");
   COMDEBUGFLAGS := ("-g");

   --  Per language flags (COMFLAGS will be added later).
   --  -gnatg/-nostdinc are NOT here: they are runtime-only, and this
   --  project's ALL_ADAFLAGS is referenced by applications too (the
   --  avrada_rts split). runtime_build.gpr/ravenscar_build.gpr add them.
   ADAFLAGS := ("-fno-delete-null-pointer-checks");
   ASMFLAGS := ("");

   case Build is
      when "Production" =>
         --  Optimize
         COMFLAGS := COMFLAGS & ("-O2");
         ADAFLAGS := ADAFLAGS & ("-gnatp", "-gnatn2");
      when "Debug" =>
         --  Disable optimization and add debug symbols
         COMFLAGS := COMFLAGS & COMDEBUGFLAGS & ("-O0");
         ASMFLAGS := ASMFLAGS & COMDEBUGFLAGS;
      when "Assert" =>
         --  Possibly enable assertions. This might use too much memory on
         --  some systems or could be too slow.
         COMFLAGS := COMFLAGS & ("-O");
         ADAFLAGS := ADAFLAGS & ("-gnata");
      when "Gnatcov" =>
         --  For coverage
         COMFLAGS := COMFLAGS & COMDEBUGFLAGS &
           ("-O0", "-fdump-scos", "-fpreserve-control-flow");
   end case;

   ------------------------------------------------------------------
   --  The ISA axis (CONTRACT.md §3.6/§3.7).
   --
   --  Hart_Class is IMPLIED by the hart mask: bit 0 is the E51, bits
   --  1..4 the U54s. It is derived HERE, once, so that libgnat, libgnarl,
   --  the application and any third crate cannot disagree about the ABI.
   --  runtime.xml used to carry a second, independent copy of this
   --  decision via external(); that file is gone (CONTRACT.md §7.10).
   ------------------------------------------------------------------

   type Hart_Mask_Kind is ("1", "2", "4", "6", "8", "16", "30");
   Hart_Mask : Hart_Mask_Kind := Light_Tasking_Mpfs_Config.Harts_Mask;

   type Hart_Class_Kind is ("e51", "u54");
   Hart_Class : Hart_Class_Kind := "u54";
   case Hart_Mask is
      when "1"    => Hart_Class := "e51";
      when others => Hart_Class := "u54";
   end case;

   --  zifencei is included because application code that copies into
   --  ITIM or DTIM must issue fence.i before executing it.
   Arch := "rv64imafdc_zicsr_zifencei";
   Abi  := "lp64d";
   case Hart_Class is
      when "e51" =>
         Arch := "rv64imac_zicsr_zifencei";   --  no FPU on the E51
         Abi  := "lp64";
      when "u54" =>
         Arch := "rv64imafdc_zicsr_zifencei";
         Abi  := "lp64d";
   end case;

   ISA_Switches := ("-march=" & Arch, "-mabi=" & Abi);

   --  Switches that must reach EVERY unit in the closure, runtime and
   --  application alike -- the job runtime.xml's
   --  Compiler'Leading_Required_Switches used to do.
   --
   --  -fno-tree-loop-distribute-patterns is not optional: without it GCC
   --  may rewrite a loop into a memcpy/memset call that a bare-metal
   --  runtime does not provide. Losing it was the one real regression
   --  from deleting runtime.xml (CONTRACT.md §7.10).
   Global_Ada_Switches := ISA_Switches & ("-fno-tree-loop-distribute-patterns");

   --  Concatenate with common flags
   ALL_ADAFLAGS := ADAFLAGS & COMFLAGS & ISA_Switches;
   ALL_ASMFLAGS := ASMFLAGS & ISA_Switches;
   GNARL_ADAFLAGS := ALL_ADAFLAGS & COMGNARLFLAGS;

   ------------------------------------------------------------------
   --  Applications rename this package (avrada_rts's pattern):
   --
   --     package Builder renames Target_Options.Builder;
   --
   --  Global_Compilation_Switches applies to EVERY project in the
   --  closure. Only the root project's Builder is honoured, which is
   --  why the application has to do the renaming.
   ------------------------------------------------------------------
   package Builder is
      for Global_Compilation_Switches ("Ada")     use Global_Ada_Switches;
      for Global_Compilation_Switches ("Asm_Cpp") use ISA_Switches;
   end Builder;

end Target_Options;
