with "runtime_build.gpr";
with "target_options.gpr";
with "config/clock_switch_e51_config.gpr";

project Clock_Switch_E51 is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("clock_switch_e51.adb");

   --  The E51 has no FPU, so a wrong ABI here is a real defect, not a
   --  cosmetic one. Renaming the runtime crate's Builder means the soft-float
   --  choice is made once, from Harts_Mask = 1, and the application cannot
   --  contradict it. Only the ROOT project's Builder is honoured, which is
   --  why the rename has to appear here (avrada_rts's pattern).
   package Builder renames Target_Options.Builder;

   package Linker is
      for Switches ("Ada") use
        --  Our -L first: ld searches -L paths for INCLUDE, so this is how
        --  app-sections.ld overrides the runtime empty default.
        ("-L", Project'Project_Dir & "ld") &
        Runtime_Build.Linker_Switches & Runtime_Build.Defsyms
        & ("-Wl,--gc-sections");
   end Linker;
end Clock_Switch_E51;
