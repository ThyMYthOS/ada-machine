--  Tier 1 (CONTRACT.md §2): the shared libgnat/libgnarl source snapshot.
--  Source-only, never built by Alire -- these units need -gnatg -nostdinc,
--  the cross compiler and no runtime, which is a bootstrap cycle. This
--  project exists only to export the two source-directory paths; it has
--  no sources of its own.
--
--  Project'Project_Dir already ends in a directory separator, so the
--  concatenations below must not add one (CONTRACT.md §2).

abstract project Rts_Sources_Gcc15 is

   for Source_Dirs use ();

   Gnat_Dir  := Project'Project_Dir & "libgnat";
   Gnarl_Dir := Project'Project_Dir & "libgnarl";

   --  Per-profile overlays. Tier 1 is NOT a flat union: 18 units differ in
   --  CONTENT between the three profiles (a-strsup, a-except, a-tags, ...),
   --  and a Source_List_File names basenames, so it cannot choose between two
   --  versions of one name. One directory cannot serve all three
   --  (CONTRACT.md 7.15).
   --
   --  Overlays are keyed by CONTENT, not by profile name: Gnat_Light_Dir is
   --  mounted by BOTH the light and light-tasking leaves, because every unit
   --  those two profiles vary is byte-identical between them on this
   --  toolchain. There is no Gnat_Light_Tasking_Dir -- it named a second,
   --  byte-identical copy of this directory. populate.sh asserts the sharing
   --  still holds and fails the build if a toolchain update breaks it
   --  (CONTRACT.md 7.16).
   Gnat_Light_Dir          := Project'Project_Dir & "libgnat-light";
   Gnat_Embedded_Dir       := Project'Project_Dir & "libgnat-embedded";

   --  Units whose owning LIBRARY varies by profile rather than their content:
   --  System.Restrictions and System.Rident are gnarl-side for light-tasking
   --  and gnat-side for embedded, byte-identically. One directory, mounted by
   --  light_tasking's ravenscar_build and by embedded's runtime_build; each
   --  leaf's Source_List_File decides which library actually claims them, so
   --  no copy is needed on either side (CONTRACT.md 7.17).
   Restrictions_Dir        := Project'Project_Dir & "librestrictions";
   Gnarl_Embedded_Dir      := Project'Project_Dir & "libgnarl-embedded";

end Rts_Sources_Gcc15;
