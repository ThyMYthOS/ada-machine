--  Tier 1 (CONTRACT.md §2): the shared libgnat/libgnarl source snapshot.
--  Source-only, never built by Alire -- these units need -gnatg -nostdinc,
--  the cross compiler and no runtime, which is a bootstrap cycle. This
--  project exists only to export the two source-directory paths; it has
--  no sources of its own.
--
--  Project'Project_Dir already ends in a directory separator, so the
--  concatenations below must not add one (CONTRACT.md §2).

abstract project Rts_Sources_Gcc15 is

   for Source_Dirs use ();

   Gnat_Dir  := Project'Project_Dir & "libgnat";
   Gnarl_Dir := Project'Project_Dir & "libgnarl";

   --  Per-profile overlays. Tier 1 is NOT a flat union: 18 units differ in
   --  CONTENT between the three profiles (a-strsup, a-except, a-tags, ...),
   --  and a Source_List_File names basenames, so it cannot choose between two
   --  versions of one name. One directory cannot serve all three
   --  (CONTRACT.md 7.15).
   --
   --  Overlays are keyed by CONTENT, not by profile name: Gnat_Light_Dir is
   --  mounted by BOTH the light and light-tasking leaves, because every unit
   --  those two profiles vary is byte-identical between them on this
   --  toolchain. There is no Gnat_Light_Tasking_Dir -- it named a second,
   --  byte-identical copy of this directory. populate.sh asserts the sharing
   --  still holds and fails the build if a toolchain update breaks it
   --  (CONTRACT.md 7.16).
   Gnat_Light_Dir          := Project'Project_Dir & "libgnat-light";
   Gnat_Embedded_Dir       := Project'Project_Dir & "libgnat-embedded";

   --  Units whose owning LIBRARY varies by profile rather than their content:
   --  System.Restrictions and System.Rident are gnarl-side for light-tasking
   --  and gnat-side for embedded, byte-identically. One directory, mounted by
   --  light_tasking's ravenscar_build and by embedded's runtime_build; each
   --  leaf's Source_List_File decides which library actually claims them, so
   --  no copy is needed on either side (CONTRACT.md 7.17).
   Restrictions_Dir        := Project'Project_Dir & "librestrictions";
   Gnarl_Embedded_Dir      := Project'Project_Dir & "libgnarl-embedded";

   ------------------------------------------------------------------
   --  This crate serves MORE THAN ONE TARGET (CONTRACT.md 7.19).
   --
   --  arm-eabi and riscv64-elf were separate tier-1 crates until measurement
   --  showed 339 of their 343 shared libgnat units, and 66 of 67 shared
   --  libgnarl units, are byte-identical -- the snapshot is keyed to the GCC
   --  release, not to the target. The common directories above hold the union
   --  of both targets' target-independent units; each leaf's Source_List_File
   --  selects its own subset, and a unit no list names is inert (7.17), so no
   --  per-target directory is needed for units that merely differ in
   --  MEMBERSHIP -- which is 122 of the 136 RISC-V-only units (128-bit integer
   --  and packed-array support a 32-bit target cannot use).
   --
   --  What genuinely disagrees in CONTENT gets an overlay pair, and NEITHER
   --  member of a pair sits in a common directory. Every axis below was
   --  measured, not assumed:
   --
   --    word size   i-cexten.ads (128-bit types), s-atopri.ads ("only the
   --                primitives available on 32 bit platforms"), s-dorepr.adb.
   --                A second 64-bit target reuses Gnat_64_Dir unchanged, which
   --                is why these are NOT in the per-target tier-2 crates.
   --    console     a-textio.adb -- semihosting versus the System.Text_IO
   --                backend. A console choice, not a target property.
   --    SMP         s-bbtime.adb -- the multiprocessor variant carries
   --                Fair_Locks. Neither version references a single
   --                architecture register, so the tasking kernel stays
   --                portable (RTS.md A.21); this is a support axis the
   --                PolarFire spike never exercised.
   --
   --  A leaf mounts exactly ONE member of each pair. That is why the five
   --  duplicate basenames across this crate's directories are safe, and why
   --  the audit that finds them must be read per leaf rather than per crate.
   ------------------------------------------------------------------
   Gnat_32_Dir             := Project'Project_Dir & "libgnat-32";
   Gnat_64_Dir             := Project'Project_Dir & "libgnat-64";
   Gnat_Textio_Dir         := Project'Project_Dir & "libgnat-textio";
   Gnat_Semihosting_Dir    := Project'Project_Dir & "libgnat-semihosting";
   Gnarl_Sp_Dir            := Project'Project_Dir & "libgnarl-sp";
   Gnarl_Smp_Dir           := Project'Project_Dir & "libgnarl-smp";

   --  Units we OWN rather than populate. libgnat-patched holds hand-authored
   --  replacements for vendored bodies, committed rather than copied, and
   --  mounted ahead of libgnat by every leaf.
   --
   --  s-lisisq.adb / s-lidosq.adb: upstream ships each twice, one body using a
   --  direct hardware sqrt and one refining a reciprocal estimate. Selecting
   --  between two FILES cost a directory per capability plus a mount in every
   --  leaf; selecting inside the body costs neither, because the branch folds in
   --  the front end -- verified by compiling for a soft-float target at -O0,
   --  where the PowerPC frsqrte asm never reaches the assembler. The capability
   --  arrives as RTS_Capabilities.Has_Hw_Sqrt_Single/_Double, a static Boolean
   --  each leaf provides under that one stable name.
   --
   --  Per-file capabilities are what the directory pair could not express: a
   --  Cortex-M4F has single-precision hardware sqrt but not double.
   --
   --  The cost is ownership. These bodies must be re-merged against upstream on
   --  a GCC bump, which is why they live in their own directory rather than
   --  among the populated sources.
   Patched_Dir             := Project'Project_Dir & "libgnat-patched";

end Rts_Sources_Gcc15;
