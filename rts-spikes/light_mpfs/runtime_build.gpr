--  light_mpfs -- leaf crate, CONTRACT.md §3. Produces adalib/libgnat.a
--  from the shared tier-1..3 source crates plus this leaf's own units.

with "rts_sources_gcc15.gpr";
with "rts_core_riscv64.gpr";
with "rts_support_mpfs.gpr";
with "gnat_user/light_mpfs_config.gpr";
with "target_options.gpr";

project Runtime_Build is

   --  Hart_Class and the ISA are derived ONCE, in target_options.gpr, so
   --  that runtime, application and any third crate share one decision
   --  (CONTRACT.md §3.6). The types are restated because a GPR case
   --  statement needs a typed variable; the VALUES come from there.
   type U54_Mask_Kind is ("1", "2", "4", "8", "16");
   U54_Hart_Mask : U54_Mask_Kind := Target_Options.U54_Hart_Mask;

   type Hart_Class_Kind is ("e51", "u54");
   Hart_Class : Hart_Class_Kind := Target_Options.Hart_Class;

   ISA_Switches := Target_Options.ISA_Switches;


   for Languages use ("Ada", "Asm_Cpp");
   for Target use "riscv64-elf";
   for Runtime ("Ada") use Project'Project_Dir;

   for Library_Name use "gnat";
   for Library_Kind use "static";
   --  EXPERIMENT: per-configuration output dirs so two applications with
   --  different [configuration.values] can coexist.
   --  Tag must cover EVERY configuration variable a compiled unit can read,
   --  or two configurations differing only in an untagged value would share
   --  one adalib and silently reuse each other's objects. Link-only values
   --  (Memory_Profile, DDR_*, Main_Stack_Size, Switch_Code_Bytes) are excluded
   --  deliberately: they change the linker invocation, not the library.
   --  GPR has no hash function, so this is an exact concatenation.
   Config_Tag := Hart_Class
     & "-" & Light_Mpfs_Config.Harts_Mask
     & "-" & Light_Mpfs_Config.Privilege
     & "-" & Light_Mpfs_Config.Console
     & "-" & Light_Mpfs_Config.Interrupt_Stack_Size
     & "-" & Light_Mpfs_Config.Secondary_Stack_Size
     & "-" & Light_Mpfs_Config.L2_Cache_Ways
     & "-" & Light_Mpfs_Config.L2_LIM_Ways
     & "-" & Light_Mpfs_Config.L2_Scratchpad_Ways
     & "-" & Light_Mpfs_Config.ITIM_Ways
     & "-" & Light_Mpfs_Config.DTIM_Ways;
   for Library_Dir use "adalib-" & Config_Tag;
   for Object_Dir  use "obj-" & Config_Tag;

   --  ORDER IS LOAD-BEARING (RTS.md §2.1, CONTRACT.md §3.4): board
   --  shadows core shadows shared; gnat_user/src (this leaf) win over
   --  all three. Source_List_File, not shadowing, is what defines
   --  membership.
   for Source_Dirs use
     ("gnat_user", "src",
      Rts_Support_Mpfs.Src_Dir,
      Rts_Core_Riscv64.Src_Dir,
      Rts_Sources_Gcc15.Gnat_Light_Dir,
      Rts_Sources_Gcc15.Gnat_Dir);

   --  Not in Languages (CONTRACT.md §3.4: "C" is embedded_mpfs-only) and
   --  not in light.lst, but physically present in the shared dirs above
   --  for other profiles. See the task report: excluding them here does
   --  NOT stop gprbuild's naming scan from failing on them regardless
   --  ("language unknown for riscv_def.h") -- reported, not solved.

   for Source_List_File use "light.lst";

   package Naming is
      for Spec_Suffix ("Asm_Cpp") use ".inc";
   end Naming;

   --  Per-unit overrides below are carried over from the shipped
   --  light-polarfiresoc runtime_build.gpr, restricted to units
   --  actually in light.lst (s-traceb.adb/s-excdeb.adb are not, and are
   --  omitted).
   --  Runtime-only: -gnatg (internal GNAT implementation mode) and
   --  -nostdinc (don't search the default RTS location). Kept out of
   --  Target_Options.ALL_ADAFLAGS because applications reference that.
   RTS_ADAFLAGS := Target_Options.ALL_ADAFLAGS & ("-gnatg", "-nostdinc");

   package Compiler is
      for Default_Switches ("Ada")     use RTS_ADAFLAGS;
      for Default_Switches ("Asm_Cpp") use Target_Options.ALL_ASMFLAGS;

      for Switches ("a-except.adb") use RTS_ADAFLAGS
        & ("-g", "-O1", "-fno-inline", "-fno-toplevel-reorder");
      for Switches ("a-tags.adb") use RTS_ADAFLAGS & ("-g");
      for Switches ("s-assert.adb") use RTS_ADAFLAGS & ("-g");

      --  Don't inline System.Machine_Reset, or the common exit path is lost.
      for Switches ("s-macres.adb") use RTS_ADAFLAGS & ("-fno-inline");

      --  ada_target_properties for GNATprove/CodePeer (RTS.md §6); a
      --  build product, like adalib/libgnat.a, not a committed file.
      for Switches ("system.ads") use RTS_ADAFLAGS
        & ("-gnatet=" & Project'Project_Dir & "ada_target_properties");
   end Compiler;

   ------------------------------------------------------------------
   --  Defsyms (CONTRACT.md §4), computed from Light_Mpfs_Config.
   --  Region bases are literal, owned by rts_support_mpfs's
   --  mpfs-memory.ld; only lengths (and local_itim's origin) are
   --  symbolic (RTS-POLARFIRE §1.2/§6.1). ld's --defsym expressions
   --  accept both '*' and the K/M suffix (e.g. "5*128K") -- verified
   --  directly against this toolchain's riscv64-elf-ld.
   ------------------------------------------------------------------

   Envm_Length := "0x1FF00";  --  fixed (CONTRACT.md §4)

   Lim_Length        := Light_Mpfs_Config.L2_LIM_Ways & "*128K";
   Scratchpad_Length := Light_Mpfs_Config.L2_Scratchpad_Ways & "*128K";

   --  L1_Way_Size_Kb is a NAMED PLACEHOLDER, not a verified hardware
   --  constant: the L1-I/L1-D way size is an open item, unconfirmed
   --  from the TRM (RTS-POLARFIRE.md §11 risk 5). Every configuration
   --  this milestone exercises has ITIM_Ways = DTIM_Ways = 0, for which
   --  this value is irrelevant (0 * anything = 0). See README "Open:
   --  L1 way size" before trusting a nonzero ITIM/DTIM length.
   L1_Way_Size_Kb := "7";  --  UNCONFIRMED

   Dtim_Length       := "0";
   E51_Itim_Length   := "0";
   U54_1_Itim_Length := "0";
   U54_2_Itim_Length := "0";
   U54_3_Itim_Length := "0";
   U54_4_Itim_Length := "0";
   Local_Itim_Origin := "0x01800000";
   Local_Itim_Length := "0";

   --  ITIM/DTIM are per-hart-private (RTS-POLARFIRE §1.4); light_mpfs
   --  is single-hart only (SMP is light_tasking_mpfs/embedded_mpfs's
   --  concern, CONTRACT.md §3.2), so exactly one window is ever owned.
   case Hart_Class is
      when "e51" =>
         Dtim_Length       := Light_Mpfs_Config.DTIM_Ways
                                 & "*" & L1_Way_Size_Kb & "K";
         E51_Itim_Length   := Light_Mpfs_Config.ITIM_Ways
                                 & "*" & L1_Way_Size_Kb & "K";
         Local_Itim_Origin := "0x01800000";
         Local_Itim_Length := E51_Itim_Length;

      when "u54" =>
         --  Single-hart masks only: light_mpfs is a single-hart profile, and
         --  ITIM is per-hart private so a multi-hart mask could not own one
         --  anyway (checked in Ada, MPFS_Config_Checks).
         case U54_Hart_Mask is
            when "2" =>
               U54_1_Itim_Length := Light_Mpfs_Config.ITIM_Ways
                                       & "*" & L1_Way_Size_Kb & "K";
               Local_Itim_Origin := "0x01808000";
               Local_Itim_Length := U54_1_Itim_Length;
            when "4" =>
               U54_2_Itim_Length := Light_Mpfs_Config.ITIM_Ways
                                       & "*" & L1_Way_Size_Kb & "K";
               Local_Itim_Origin := "0x01810000";
               Local_Itim_Length := U54_2_Itim_Length;
            when "8" =>
               U54_3_Itim_Length := Light_Mpfs_Config.ITIM_Ways
                                       & "*" & L1_Way_Size_Kb & "K";
               Local_Itim_Origin := "0x01818000";
               Local_Itim_Length := U54_3_Itim_Length;
            when "16" =>
               U54_4_Itim_Length := Light_Mpfs_Config.ITIM_Ways
                                       & "*" & L1_Way_Size_Kb & "K";
               Local_Itim_Origin := "0x01820000";
               Local_Itim_Length := U54_4_Itim_Length;
            when others =>
               null;  --  multi-hart Harts: no single owned ITIM here
         end case;
   end case;

   --  DDR: absent unless DDR_Present (RTS-POLARFIRE §1.3/§6.2's
   --  LENGTH = 0 idiom for "alias not present").
   Ddr_Cached_Length := "0";
   Ddr_Nc_Length     := "0";
   Ddr_Wcb_Length    := "0";

   case Light_Mpfs_Config.DDR_Present is
      when "True" =>
         Ddr_Cached_Length := Light_Mpfs_Config.DDR_Cached_KB & "K";
         Ddr_Nc_Length     := Light_Mpfs_Config.DDR_NonCached_KB & "K";
         Ddr_Wcb_Length    := Light_Mpfs_Config.DDR_WCB_KB & "K";
      when others =>
         null;
   end case;

   Defsyms :=
     ("-Wl,--defsym=MPFS_ENVM_LENGTH="       & Envm_Length,
      "-Wl,--defsym=MPFS_DTIM_LENGTH="       & Dtim_Length,
      "-Wl,--defsym=MPFS_E51_ITIM_LENGTH="   & E51_Itim_Length,
      "-Wl,--defsym=MPFS_U54_1_ITIM_LENGTH=" & U54_1_Itim_Length,
      "-Wl,--defsym=MPFS_U54_2_ITIM_LENGTH=" & U54_2_Itim_Length,
      "-Wl,--defsym=MPFS_U54_3_ITIM_LENGTH=" & U54_3_Itim_Length,
      "-Wl,--defsym=MPFS_U54_4_ITIM_LENGTH=" & U54_4_Itim_Length,
      "-Wl,--defsym=MPFS_LOCAL_ITIM_ORIGIN=" & Local_Itim_Origin,
      "-Wl,--defsym=MPFS_LOCAL_ITIM_LENGTH=" & Local_Itim_Length,
      "-Wl,--defsym=MPFS_LIM_LENGTH="        & Lim_Length,
      "-Wl,--defsym=MPFS_SCRATCHPAD_LENGTH=" & Scratchpad_Length,
      "-Wl,--defsym=MPFS_DDR_CACHED_LENGTH=" & Ddr_Cached_Length,
      "-Wl,--defsym=MPFS_DDR_NC_LENGTH="     & Ddr_Nc_Length,
      "-Wl,--defsym=MPFS_DDR_WCB_LENGTH="    & Ddr_Wcb_Length);

   ------------------------------------------------------------------
   --  Linker_Switches (CONTRACT.md §3.7): -T/-L for the selected
   --  Memory_Profile, from Rts_Support_Mpfs.Ld_Dir. Deliberately does
   --  NOT append Defsyms -- the app concatenates both itself.
   ------------------------------------------------------------------

   Placement_Script := "place-lim.ld";
   case Light_Mpfs_Config.Memory_Profile is
      when "envm" =>
         Placement_Script := "place-envm.ld";
      when "lim" =>
         Placement_Script := "place-lim.ld";
      when "lim_lma_scratchpad_vma" =>
         Placement_Script := "place-lim-lma-scratchpad-vma.ld";
      when "envm_lma_scratchpad_vma" =>
         Placement_Script := "place-envm-lma-scratchpad-vma.ld";
      when "ddr_by_bootloader" =>
         Placement_Script := "place-ddr-by-bootloader.ld";
      when "system_partition" =>
         --  Generated per-partition script (RTS-POLARFIRE §4/§6.1);
         --  standalone mode (MPFS_PARTITION = "") does not use it.
         Placement_Script := "partition-" & Light_Mpfs_Config.MPFS_PARTITION
                                & ".ld";
   end case;

   Linker_Switches :=
     ("-L", Rts_Support_Mpfs.Ld_Dir,
      "-T", Placement_Script)
     --  This project, not runtime.xml, is the only source of link
     --  switches (avrada_rts's Linker_Switches pattern, CONTRACT.md §3.7).
     & ISA_Switches & ("-nostartfiles", "-nolibc",
        "-Wl,--defsym=__stack_size=" & Light_Mpfs_Config.Main_Stack_Size);

end Runtime_Build;
