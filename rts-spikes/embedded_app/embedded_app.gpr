with "runtime_build.gpr";
with "ravenscar_build.gpr";
with "target_options.gpr";
with "config/embedded_app_config.gpr";

project Embedded_App is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("embedded_app.adb");

   --  The ABI comes from the runtime crate, derived once from the hart
   --  mask, and covers Ada, Asm_Cpp and C. Renaming rather than restating
   --  keeps every unit in the closure on one decision (avrada_rts's
   --  pattern; only the ROOT project's Builder is honoured).
   package Builder renames Target_Options.Builder;

   package Linker is
      for Switches ("Ada") use
        Runtime_Build.Linker_Switches & Runtime_Build.Defsyms
        & ("-Wl,--gc-sections");
   end Linker;
end Embedded_App;
