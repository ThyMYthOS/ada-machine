--  light_tasking_pico -- leaf crate, mirrors rts-spikes/CONTRACT.md §3.
--  Produces adalib/libgnat.a from the shared tier-1..3 source crates plus
--  this leaf's own units.

with "rts_sources_gcc15.gpr";
with "rts_core_cortexm.gpr";
with "rts_support_pico.gpr";
with "gnat_config/light_tasking_pico_config.gpr";
with "target_options.gpr";

project Runtime_Build is

   type Device_Kind is ("rp2040", "rp2350");
   Device : Device_Kind := Target_Options.Device;

   ISA_Switches := Target_Options.ISA_Switches;

   for Languages use ("Ada", "Asm_Cpp");
   for Target use "arm-eabi";
   for Runtime ("Ada") use Project'Project_Dir;

   for Library_Name use "gnat";
   for Library_Kind use "static";
   for Library_Dir use "adalib";
   for Object_Dir use "obj";

   --  ORDER IS LOAD-BEARING (mirrors rts-spikes/CONTRACT.md §3.4): board
   --  shadows core shadows shared; gnat_config/src (this leaf) win over
   --  all three. Source_List_File, not shadowing, is what defines
   --  membership.
   --  There is no per-DEVICE overlay in tier 1 or tier 2. The two units that
   --  differ between RP2040 (ARMv6-M) and RP2350 (ARMv8-M) are s-lidosq.adb
   --  and s-lisisq.adb, and they differ between two 32-bit targets -- so they
   --  are not a word-size axis and cannot live in Gnat_32_Dir. Rather than
   --  give either tier a per-device pair, they are single MERGED bodies in
   --  Patched_Dir that test RTS_Capabilities in an expression the front end
   --  folds (src/rts_capabilities.ads, RTS.md 5.5). That is what lets one
   --  tier-1 snapshot serve both ARM generations -- and it is also the only
   --  mechanism that can express the RP2350 case, whose M33 FPU has a
   --  single-precision square root but no double-precision one.
   --
   --  The device axis therefore lives entirely in TIER 3, as the
   --  src-rp2040/ | src-rp2350/ overlay below. Selecting Device => rp2350 is
   --  refused by the Compile_Time_Error in src/pico_config_checks.ads, which
   --  names what is still missing.
   for Source_Dirs use
     ("gnat_config", "src",
      --  RP2040's half of the 5 board units the two devices disagree on;
      --  Rts_Support_Pico.Rp2350_Dir is the other, and carries the same names.
      Rts_Support_Pico.Rp2040_Dir,
      Rts_Support_Pico.Src_Dir,
      Rts_Core_Cortexm.Src_Dir,
      Rts_Sources_Gcc15.Gnat_32_Dir,
      Rts_Sources_Gcc15.Gnat_Semihosting_Dir,
      Rts_Sources_Gcc15.Patched_Dir,
      Rts_Sources_Gcc15.Gnat_Dir);

   for Source_List_File use "runtime.gnat.lst";

   package Naming is
      for Spec_Suffix ("Asm_Cpp") use ".inc";
   end Naming;

   --  Runtime-only: -gnatg (internal GNAT implementation mode) and
   --  -nostdinc (don't search the default RTS location). Kept out of
   --  Target_Options.ALL_ADAFLAGS because applications reference that.
   RTS_ADAFLAGS := Target_Options.ALL_ADAFLAGS & ("-gnatg", "-nostdinc");

   package Compiler is
      for Default_Switches ("Ada")     use RTS_ADAFLAGS;
      for Default_Switches ("Asm_Cpp") use Target_Options.ALL_ASMFLAGS;

      --  Carried over from the vendor light-tasking-rpi-pico runtime_build.gpr,
      --  restricted to units actually in runtime.gnat.lst.
      for Switches ("a-except.adb") use RTS_ADAFLAGS
        & ("-g", "-O1", "-fno-inline", "-fno-toplevel-reorder");
      for Switches ("a-tags.adb") use RTS_ADAFLAGS & ("-g");
      for Switches ("s-assert.adb") use RTS_ADAFLAGS & ("-g");
      for Switches ("s-macres.adb") use RTS_ADAFLAGS & ("-fno-inline");

      for Switches ("system.ads") use RTS_ADAFLAGS
        & ("-gnatet=" & Project'Project_Dir & "ada_target_properties");
   end Compiler;

   ------------------------------------------------------------------
   --  Linker_Switches (mirrors rts-spikes/CONTRACT.md §3.7): -T/-L for the
   --  single RP2040 memory map (no PolarFire-style Memory_Profile axis --
   --  rts_support_pico/README.md), plus the one defsym that map needs.
   --
   --  PICO_FLASH_LENGTH is why there is no ld/flash-<n>/ directory set here
   --  (RTS.md §5.3 / A.25): the flash size is a number, so it travels as a
   --  symbol. The "K" suffix is ld's own -- --defsym takes the same size
   --  suffixes a script does, so nothing converts units on the way.
   ------------------------------------------------------------------
   Linker_Switches :=
     ("-L", Rts_Support_Pico.Ld_Dir,
      "-T", "common-ROM.ld")
     & ISA_Switches & ("-nostartfiles", "-nolibc",
        "-Wl,--defsym=PICO_FLASH_LENGTH="
          & Light_Tasking_Pico_Config.Flash_Size_KB & "K");

end Runtime_Build;
