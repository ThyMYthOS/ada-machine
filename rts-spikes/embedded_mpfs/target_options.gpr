--  Build-profile compiler switches shared by Runtime_Build and
--  Ravenscar_Build. Adapted from the upstream embedded-polarfiresoc
--  runtime shipped in gnat_riscv64_elf 15.1.2 (identical in 15.3.1)
--  (~/.local/share/alire/toolchains/gnat_riscv64_elf_15.1.2_*/riscv64-elf/
--  lib/gnat/embedded-polarfiresoc/target_options.gpr), trimmed to what this
--  spike's fixed `for Library_Kind use "static";` (CONTRACT.md §3.4) needs:
--  the upstream Lib_Type / LOPTIONS / Library_Version machinery for an
--  alternative "dynamic" library is dropped since this leaf never selects
--  it.
--
--  External() names are prefixed with the crate name, matching the
--  convention the community-index `embedded_stm32g4xx` crate uses for the
--  same two knobs (EMBEDDED_STM32G4XX_BUILD / _LIBRARY_TYPE) -- otherwise
--  a bare "-XBUILD=" would leak across every runtime crate sharing one
--  gprbuild invocation.
--
--  Extended along the lines of avrada_rts's avr_tool_options.gpr: this
--  project, not runtime.xml, is the single place the target ISA is
--  decided, and it exports a Builder package for applications to
--  rename. See CONTRACT.md §3.6.

with "gnat_config/embedded_mpfs_config.gpr";

abstract project Target_Options is

   type Build_Type is ("Production", "Debug", "Assert", "Gnatcov");
   Build : Build_Type := external ("EMBEDDED_MPFS_BUILD", "Production");

   --  GNAT version string (informational; not consumed by this leaf's own
   --  project files, carried over for parity with upstream).
   Version := external ("GNAT_VERSION", "15");

   --  COMFLAGS here is common flags (used for C and Ada).
   COMFLAGS := ("-ffunction-sections",
                "-fdata-sections",
                "-fcallgraph-info=su,da");
   COMGNARLFLAGS := ("");
   COMDEBUGFLAGS := ("-g");

   ------------------------------------------------------------------
   --  The boot-role axis (CONTRACT.md §3.6, RTS-PRODUCTION.md §A6).
   --
   --  Boot_Role and Harts_Mask must reach start.S, which is compiled
   --  as "Asm_Cpp" (goes through the C preprocessor) -- so they arrive
   --  as -D defines in ASMFLAGS below, the assembly analogue of an
   --  in-body static test. MPFS_BOOT_ROLE_PRIMARY is 1/0 rather than a
   --  symbol name so the file can gate on it with a plain #if.
   ------------------------------------------------------------------
   type Boot_Role_Kind is ("primary", "secondary");
   Boot_Role : Boot_Role_Kind := Embedded_Mpfs_Config.Boot_Role;

   Boot_Role_Primary := "0";
   case Boot_Role is
      when "primary"   => Boot_Role_Primary := "1";
      when "secondary" => null;
   end case;

   --  Per language flags (COMFLAGS will be added later)
   --  -gnatg/-nostdinc are NOT here: they are runtime-only, and this
   --  project's ALL_ADAFLAGS is referenced by applications too (the
   --  avrada_rts split). runtime_build.gpr/ravenscar_build.gpr add them.
   ADAFLAGS := ("-fno-delete-null-pointer-checks");
   ASMFLAGS := ("-DMPFS_BOOT_ROLE_PRIMARY=" & Boot_Role_Primary,
                "-DMPFS_HARTS_MASK=" & Embedded_Mpfs_Config.Harts_Mask);
   CFLAGS := ("-DIN_RTS", "-Dinhibit_libc", "-DLIGHT_RUNTIME", "-Werror", "-Wall");
   --  "-DLIGHT_RUNTIME" is carried over verbatim from the upstream
   --  embedded-polarfiresoc target_options.gpr (task instruction: read it
   --  and carry the switches over). It is not referenced by any .c file
   --  actually in this crate's unit set (grep across
   --  rts_sources_gcc15/libgnat/*.c found no use), so it is inert, but
   --  changing it risks losing fidelity to what upstream actually ships.

   case Build is
      when "Production" =>
         --  Optimize
         COMFLAGS := COMFLAGS & ("-O2");
         ADAFLAGS := ADAFLAGS & ("-gnatp", "-gnatn2");
      when "Debug" =>
         --  Disable optimization and add debug symbols
         COMFLAGS := COMFLAGS & COMDEBUGFLAGS & ("-O0");
         ASMFLAGS := ASMFLAGS & COMDEBUGFLAGS;
      when "Assert" =>
         --  Possibly enable assertions.
         COMFLAGS := COMFLAGS & ("-O");
         ADAFLAGS := ADAFLAGS & ("-gnata");
      when "Gnatcov" =>
         --  For coverage
         COMFLAGS := COMFLAGS & COMDEBUGFLAGS &
           ("-O0", "-fdump-scos", "-fpreserve-control-flow");
   end case;

   ------------------------------------------------------------------
   --  The ISA axis (CONTRACT.md §3.6/§3.7).
   --
   --  Hart_Class is IMPLIED by the hart mask: bit 0 is the E51, bits
   --  1..4 the U54s. It is derived HERE, once, so that libgnat, libgnarl,
   --  the application and any third crate cannot disagree about the ABI.
   --  runtime.xml used to carry a second, independent copy of this
   --  decision via external(); that file is gone (CONTRACT.md §7.10).
   ------------------------------------------------------------------

   type Hart_Mask_Kind is ("1", "2", "4", "6", "8", "16", "30");
   Hart_Mask : Hart_Mask_Kind := Embedded_Mpfs_Config.Harts_Mask;

   type Hart_Class_Kind is ("e51", "u54");
   Hart_Class : Hart_Class_Kind := "u54";
   case Hart_Mask is
      when "1"    => Hart_Class := "e51";
      when others => Hart_Class := "u54";
   end case;

   --  zifencei is included because application code that copies into
   --  ITIM or DTIM must issue fence.i before executing it.
   Arch := "rv64imafdc_zicsr_zifencei";
   Abi  := "lp64d";
   case Hart_Class is
      when "e51" =>
         Arch := "rv64imac_zicsr_zifencei";   --  no FPU on the E51
         Abi  := "lp64";
      when "u54" =>
         Arch := "rv64imafdc_zicsr_zifencei";
         Abi  := "lp64d";
   end case;

   ISA_Switches := ("-march=" & Arch, "-mabi=" & Abi);

   --  Switches that must reach EVERY unit in the closure, runtime and
   --  application alike -- the job runtime.xml's
   --  Compiler'Leading_Required_Switches used to do.
   --
   --  -fno-tree-loop-distribute-patterns is not optional: without it GCC
   --  may rewrite a loop into a memcpy/memset call that a bare-metal
   --  runtime does not provide. Losing it was the one real regression
   --  from deleting runtime.xml (CONTRACT.md §7.10).
   Global_Ada_Switches := ISA_Switches & ("-fno-tree-loop-distribute-patterns");

   --  Concatenate with common flags
   ALL_ADAFLAGS   := ADAFLAGS & COMFLAGS & ISA_Switches;
   ALL_CFLAGS     := CFLAGS & COMFLAGS & ISA_Switches;
   ALL_ASMFLAGS   := ASMFLAGS & ISA_Switches;
   GNARL_ADAFLAGS := ALL_ADAFLAGS & COMGNARLFLAGS;
   GNARL_CFLAGS   := ALL_CFLAGS & COMGNARLFLAGS;

   ------------------------------------------------------------------
   --  Applications rename this package (avrada_rts's pattern):
   --
   --     package Builder renames Target_Options.Builder;
   --
   --  Global_Compilation_Switches applies to EVERY project in the
   --  closure. Only the root project's Builder is honoured, which is
   --  why the application has to do the renaming.
   ------------------------------------------------------------------
   --  "C" is listed because this is the one profile that compiles C (the
   --  unwinder, raise-gcc.c); a C object built with the wrong ABI links
   --  without complaint from the Ada side.
   package Builder is
      for Global_Compilation_Switches ("Ada")     use Global_Ada_Switches;
      for Global_Compilation_Switches ("Asm_Cpp") use ISA_Switches;
      for Global_Compilation_Switches ("C")       use Global_Ada_Switches;
   end Builder;

end Target_Options;
