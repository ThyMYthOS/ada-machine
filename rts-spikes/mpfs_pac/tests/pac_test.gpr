--  Standalone smoke test: does the generated PAC compile and link as
--  ordinary Ada. Not part of `mpfs_pac.gpr` (an application shouldn't pull
--  in a test main through its library dependency) and not yet wired into
--  rts-spikes/Makefile -- see mpfs_pac's README/alire.toml for how to run
--  it (`gprbuild -P tests/pac_test.gpr && ./tests/bin/pac_test`).

with "../mpfs_pac.gpr";

project Pac_Test is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("pac_test.adb");
   for Create_Missing_Dirs use "true";

   package Compiler is
      for Default_Switches ("ada") use ("-gnatwa", "-gnat2022");
   end Compiler;

end Pac_Test;
