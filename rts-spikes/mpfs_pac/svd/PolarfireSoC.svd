        </register>
        <register>
          <name>SPARE_REGISTER_W1P</name>
          <description>Register for ECO usage</description>
          <addressOffset>0x2D4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>No function, provided for future ECO use</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPARE_REGISTER_RO</name>
          <description>Register for ECO usage</description>
          <addressOffset>0x2D8</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Provides readback of { W1P, RW } registers. No function, provided for future ECO use.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPARE_PERIM_RW</name>
          <description>Spare signal back to PFC</description>
          <addressOffset>0x2DC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MMUART0_RXD</name>
              <description>When set MMUART0 RXD is received on perimeter 5 from PFC. When enabled in PFC it the SPI SDI input is drives this connection. When enabled the PFC QSPI interrupt is disabled. (This function intended for manufacturing use only)</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MMUART0_TXD</name>
              <description>When set MMUART0 TXD is sent on Perimeter 2 to PFC, when enabled in PFC it will be output on the SPI SDO pin. (This function intended for manufacturing use only)</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DATA</name>
              <description>Controls perim_spare_out bits 5 7 &amp; 9 when the ENABLE bits set</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENABLE</name>
              <description>Allows the MSS to control the perim_spare_out bits 5 7 &amp; 9. No function, provided for future ECO use.</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPARE_FIC</name>
          <description>Unused FIC resets</description>
          <addressOffset>0x2E0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESET</name>
              <description>Connected to spare FIC 0-3 Reset inputs to provide simple RO bits. No defined use</description>
              <bitRange>[3:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCB_REGS</name>
      <description>SCB_REGS Controller</description>
      <baseAddress>0x20003000</baseAddress>
      <registers>
        <register>
          <name>SOFT_RESET</name>
          <description>System Reset Register. This MSS soft reset register is not readable or writeable by the MSS or user or DRI.</description>
          <addressOffset>0x000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x07200000</resetValue>
          <fields>
            <field>
              <name>BLOCKID</name>
              <description>This returns the block type and chip location.</description>
              <bitRange>[31:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>PERIPH</name>
              <description>This asserts the functional reset of the block. It is asserted at power up, the bit self clears i.e. is similar to a W1P bit. This bit is activated global_periph_reset</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>V_MAP</name>
              <description>This when asserted resets all the register bits apart from the non-volatile registers, the bit self clears i.e. is similar to a W1P bit. This bit is activated global_map_reset.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NV_MAP</name>
              <description>This when asserted resets all the non-volatile register bits e.g. RW-P bits, the bit self clears i.e. is similar to a W1P bit. This bit is activated global_map_reset.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AXI_WSETUP</name>
          <description>Axi Write Setup. Not accesible from MSS or user or DRI.</description>
          <addressOffset>0x010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SYSTEM</name>
              <description>0: AXI transaction uses ID 0 and passes through MPU block 1: AXI transaction uses ID 1 and bypasses the MPU block</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>QOS</name>
              <description>Sets the AXI QOS value, higher values have higher priority in the switch</description>
              <bitRange>[30:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PROT</name>
              <description>Sets the AXI protection value</description>
              <bitRange>[26:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CACHE</name>
              <description>Sets the AXI Cache value</description>
              <bitRange>[23:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LOCK</name>
              <description>Sets the AXI lock</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SIZE</name>
              <description>Set the AXI size (width)</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LENGTH</name>
              <description>Sets the AXI burst length</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BURST</name>
              <description>Sets the AXi burst type</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ADDR</name>
              <description>Sets the upper 6-bits of the address bus</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AXI_WADDR</name>
          <description>AXI Write Address. Not accesible from MSS or user or DRI.</description>
          <addressOffset>0x014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADDR</name>
              <description>This sets the AXI write address. A write to this register triggers the AXI AW cycle</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AXI_WDATA</name>
          <description>AXI Write Data. This is write only register, reads will return zero. Not accesible from MSS or user or DRI.</description>
          <addressOffset>0x018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Write Data, when written will initiate a AHB write transfer through the write data FIFO.Data must be written using word operations. If AWSIZE&lt;=2 then a AXI Write data cycle will be started every cycle, if AWSIZE=3 a AXI Write data cycle will be started every other cycle.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AXI_RSETUP</name>
          <description>AXI Read Setup. Not accesible from MSS or user or DRI.</description>
          <addressOffset>0x01C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SYSTEM</name>
              <description>0: AXI transaction uses ID 0 and passes through MPU block 1: AXI transaction uses ID 1 and bypasses the MPU block</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>QOS</name>
              <description>Sets the AXI QOS value, higher values have higher priority in the switch</description>
              <bitRange>[30:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PROT</name>
              <description>Sets the AXI protection value</description>
              <bitRange>[26:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CACHE</name>
              <description>Sets the AXI Cache value</description>
              <bitRange>[23:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LOCK</name>
              <description>Sets the AXI lock</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SIZE</name>
              <description>Set the AXI size (width)</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LENGTH</name>
              <description>Sets the AXI burst length</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BURST</name>
              <description>Sets the AXi burst type</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ADDR</name>
              <description>Sets the upper 6-bits of the address bus</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AXI_RADDR</name>
          <description>AXI Read Address. Not accesible from MSS or user or DRI.</description>
          <addressOffset>0x020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADDR</name>
              <description>This sets the AXI read address. A write to this register triggers the AXI AR cycle</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AXI_RDATA</name>
          <description>AHB Read data. This is a read only register, writes will be have no effect.</description>
          <addressOffset>0x024</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Read data from the AXI read FIFO</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AXI_STATUS</name>
          <description>AXI Master Status. Not accessible from MSS or user or DRI. This register provides status information and writes only supported on bits 28:24</description>
          <addressOffset>0x028</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>INT_ENABLE_SYSREG</name>
              <description>Enable SCB interrupt from the SCB Interrupt register</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INT_ENABLE_WRESP</name>
              <description>Enable SCB interrupt on write response error</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INT_ENABLE_RRESP</name>
              <description>Enable SCB interrupt on read response error</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INT_ENABLE_WRITE_ORUN</name>
              <description>Enable SCB interrupt on write overrun</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INT_ENABLE_READ_ORUN</name>
              <description>Enable SCB interrupt on read overrun</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MSS_RESET</name>
              <description>Indicates that the MSS has been reset and the SCB transfer may have failed. Is the internal MSS sticky_reset signal</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>READ_RESPONSE</name>
              <description>Indicates the read response. When a non-zero value is detected the register will hold the value until the read_error bit is cleared or abort asserted</description>
              <bitRange>[19:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WRITE_RESPONSE</name>
              <description>Indicates the write response. When a non-zero value is detected the register will hold the value until the write_error bit is cleared or abort asserted</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WRITE_OVERRUN</name>
              <description>Indicates the SCB bus wrote the write FIFO when empty. Is cleared by writing a ‘1’</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>READ_OVERRUN</name>
              <description>Indicates the SCB bus read the read FIFO when empty. Is cleared by writing a ‘1’</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>READ_COUNT</name>
              <description>Indicates how many 32-bit words are stored in the read FIFO</description>
              <bitRange>[13:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WRITE_COUNT</name>
              <description>Indicates how many 32-bit words are stored in the write FIFO</description>
              <bitRange>[8:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>READ_ERROR</name>
              <description>Set when a read error response is received. Is cleared by writing a ‘1’</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WRITE_ERROR</name>
              <description>Set when a write error response is received. Is cleared by writing a ‘1’</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>READ_BUSY</name>
              <description>Set during arvalid cycle and cleared on the last read response</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WRITE_BUSY</name>
              <description>Set during awvalid cycle and cleared on the write response</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AXI_CONTROL</name>
          <description>AXI Cycle Controls. Not accesible from MSS or user or DRI.</description>
          <addressOffset>0x02C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>START_WRITE</name>
              <description>Starts AXI transfer when STALL_WRITE is set, reads as zero</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>STALL_WRITE</name>
              <description>When set prevents the logic initiating AW cycle automatically. Write is started by START_WRITE. Allows up to 16 words (32-bits) of data to be queued allowing AXI to run more efficiently.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ABORT</name>
              <description>Abort current transfer and reset the FSMS. May cause AXI protocol violations</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REDUNDANCY</name>
          <description>Used to program MSS RAM redundancy system during system startup</description>
          <addressOffset>0x030</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <fields>
            <field>
              <name>NOCLOCK</name>
              <description>When set stops the SCB clock creating the Redundancy clock. To allow for large recovery times on the redundancy ISOLATE and RESET inputs this bit should be set prior to toggling the reset/isolate bits and cleared afterwards.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISOLATE</name>
              <description>Asserts the Redundacy isolate, interface isolated when 1 (can be accessed by MSS in factory mode)</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESET</name>
              <description>Asserts the Redundacy reset (can be accessed by MSS in factory mode)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BIST_CONFIG</name>
          <description>Used to access the BIST systems</description>
          <addressOffset>0x050</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <fields>
            <field>
              <name>MARGIN</name>
              <description>Set the BIST memory margin, factory mode only</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SELECT</name>
              <description>Select the BIST engine 0-15</description>
              <bitRange>[12:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DIAG_SELECT</name>
              <description>Assert the DIAG select</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESET</name>
              <description>Assert the BIST reset</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENABLE</name>
              <description>Enable the CPU BIST system</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENABLED</name>
              <description>Indicates that CPU may use BIST system, UFS bit may disable this interface, available when factory mode set</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BIST_DATA</name>
          <description>Data value to be shifted into BIST system</description>
          <addressOffset>0x054</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Writes sets the data value to shifted, LSB shifted out first. Reads returns the shifted in value, MSB is last bit shifted in.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BIST_COMMAND</name>
          <description>BIST Shift Controls</description>
          <addressOffset>0x058</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00002000</resetValue>
          <fields>
            <field>
              <name>LENGTH</name>
              <description>Number of bits to shift 1-127. If set to &gt;32 the outgoing shift data for bits 33 upwards will be zero. This allows MBIST with CSR registers greater than 32 to be started with valid data loaded into bits 23:0 off the CSR register as specified in the data register. When &gt;32 incoming data is not captured in the shift register, if the read data is to extracted then each shift operation should be &lt;=32 bits. To read a 88 bit register will require 3 shift operatiosn of 32, 32 and 24 bits</description>
              <bitRange>[14:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BUSY</name>
              <description>Indicates that the shift is in progress.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SHIFT</name>
              <description>Perform the specified number off shift cycles.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CAPTURE</name>
              <description>Do a shift cycle, may be asserted at the same time as shift, capture is asserted before shift operations start.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>UPDATE</name>
              <description>Do an update cycle</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MSS_RESET_CR</name>
          <description>MSS reset Controls</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000107</resetValue>
          <fields>
            <field>
              <name>REASON</name>
              <description>This provides a read off the main SYSREG reset reason register</description>
              <bitRange>[24:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SGMII</name>
              <description>Asserts a reset the SGMII block containing the MSS reference clock input. Warning that setting this bit causes the external reference clock input to the MSS PLL to disappear. It is advisable to use the SGMII channel soft resets in the PHY instead of this bit. However if E51 software wants to set this bit, the MSS clock source should be switched over to the standby source in advance.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>REBOOT_REQUEST</name>
              <description>Reading returns the value of reboot_request. Writing 1 clears the reboot request and the fabric reset enable register</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CPUINRESET</name>
              <description>Indicates that the CPU's are being help in reset. Will stay active for sixteen CPU clocks after the CPU resets are released</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>MSS</name>
              <description>Holds the MSS system (i.e. AXI/AHB/APB resets) in reset. When asserted the CPU's are also held in reset. The Trace UDB reset is not asserted by this bit.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CPU</name>
              <description>Holds the CPUS (corplex) in reset.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MSS_STATUS</name>
          <description>MSS Status</description>
          <addressOffset>0x104</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ECC_ERROR_OTHER</name>
              <description />
              <bitRange>[16:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ECC_ERROR_L2</name>
              <description />
              <bitRange>[15:15]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>HALT_CPU4</name>
              <description />
              <bitRange>[14:14]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>HALT_CPU3</name>
              <description />
              <bitRange>[13:13]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>HALT_CPU2</name>
              <description />
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>HALT_CPU1</name>
              <description />
              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>HALT_CPU0</name>
              <description />
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DEBUG_ACTIVE</name>
              <description />
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>WATCHDOG</name>
              <description />
              <bitRange>[8:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>BOOT_STATUS</name>
              <description />
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BOOT_ADDR0</name>
          <description />
          <addressOffset>0x108</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x20003120</resetValue>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Boot Address i.e. reset vector for the coreplex</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BOOT_ADDR1</name>
          <description />
          <addressOffset>0x10C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x20003120</resetValue>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Boot Address i.e. reset vector for the coreplex</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BOOT_ADDR2</name>
          <description />
          <addressOffset>0x110</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x20003120</resetValue>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Boot Address i.e. reset vector for the coreplex</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BOOT_ADDR3</name>
          <description />
          <addressOffset>0x114</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x20003120</resetValue>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Boot Address i.e. reset vector for the coreplex</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BOOT_ADDR4</name>
          <description />
          <addressOffset>0x118</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x20003120</resetValue>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Boot Address i.e. reset vector for the coreplex</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BOOT_ROM0</name>
          <description>32-byte ROM for CPU booting Holds eight 32-bit Instructions</description>
          <addressOffset>0x120</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000513</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>li a0,0</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BOOT_ROM1</name>
          <description />
          <addressOffset>0x124</addressOffset>
          <size>32</size>
