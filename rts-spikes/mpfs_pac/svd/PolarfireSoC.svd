              <bitOffset>3</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>EP4</name><description>TX EP4 interrupt pending</description>
              <bitOffset>4</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>EP5</name><description>TX EP5 interrupt pending</description>
              <bitOffset>5</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>EP6</name><description>TX EP6 interrupt pending</description>
              <bitOffset>6</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>EP7</name><description>TX EP7 interrupt pending</description>
