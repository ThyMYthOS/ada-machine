        <register>
          <name>ERROR_STATUS</name>
          <description>CAN error status indicator register</description>
          <addressOffset>0x010</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RXGTE96</name>
              <description>The receive error counter is greater or equal 96 dec.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TXGTE96</name>
              <description>The transmit error counter is greater or equal 96 dec.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ERROR_STATE</name>
              <description>The error state of the CAN mode: 00: error active (normal operation) 01: error passive 1x: bus off</description>
              <bitRange>[17:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RX_ERR_CNT</name>
              <description>The receive error counter as defined in CAN 2.0 specification. When in bus-off state.. this counter is used to count 128 groups of 11 receive bits.</description>
              <bitRange>[15:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TX_ERR_CNT</name>
              <description>The transmit error counter as defined in CAN 2.0 specification. When it is greater than 255 dec.. it is fixed at 255 dec.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_COMMAND</name>
          <description>The CAN controller can be used in different operating modes. By disabling transmitting data.. it is possible to use the CAN in Listen-only mode.. enabling features such as automatic bit rate detection. Before starting the CAN controller.. all the CAN configuration registers have to be set according to the target application.</description>
          <addressOffset>0x014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>REVISION_CONTROL</name>
              <description>This field contains the version of the CAN core in the following format. This is a read-only field. [major version].[minor version].[revision number] [31:28]: Major version [27:24]: Minor version [23:16]: Revision number</description>
              <bitRange>[31:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SRAM_TEST_MODE</name>
              <description>SRAM Test mode 0: Normal operation 1: Enable SRAM Test mode.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LOOPBACK_TEST_MODE</name>
              <description>Loopback-test mode 0: Normal operation 1: Loopback mode is enabled[1]: Listen-only mode.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LISTEN_ONLY_MODE</name>
              <description>Listen-only mode 0: Active 1: CAN listen only. The output is held at 'R' level. The CAN controller is only listening.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RUN_STOP_MODE</name>
              <description>Run/Stop mode 0: Sets the CAN controller into Stop mode. Returns 0 when stopped. 1: Sets the CAN controller into Run mode. Returns 1 when running.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_CONFIG</name>
          <description>CAN configuration register.</description>
          <addressOffset>0x018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CFG_BITRATE</name>
              <description>Configuration bit rate Prescaler for generating the time quantum which defines the TQ: 0: One time quantum equals 1 clock cycle 1: One time quantum equals 2 clock cycles 32767: One time quantum equals 32768 clock cycles</description>
              <bitRange>[30:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ECR_MODE</name>
              <description>Error-capture mode 0: Free running. The ECR register shows the current bit position within the CAN frame. 1: Capture mode. The ECR register shows the bit position and type of the last captured CAN error.</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SWAP_ENDIAN</name>
              <description>The byte position of the CAN receive and transmit data fields can be modified to match the endian setting of the processor or the used CAN protocol. 0: CAN data byte position is not swapped (big endian). 1: CAN data byte position is swapped (little endian).</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CFG_ARBITER</name>
              <description>Transmit buffer arbiter 0: Round robin arbitration. 1: Fixed priority arbitration.</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CFG_TSEG1</name>
              <description>Time segment 1. Time segment 1 includes the propagation time Length of the first time segment: tseg1 = CFG_TSEG1+1 CFG_TSEG1 = 0 and CFG_TSEG1 = 1 are not allowed.</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CFG_TSEG2</name>
              <description>Time segment 2 Length of the second time segment: tseg2 = CFG_TSEG2+1 CFG_TSEG2 = 0 is not allowed. CFG_TSEG2 = 1 is only allowed in Direct-sampling mode.</description>
              <bitRange>[7:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AUTO_RESTART</name>
              <description>The CAN can be set to restart either 'by hand' or automatically after a bus-off. 0: After bus-off.. the CAN must be restarted 'by hand'. This is the recommended setting. 1: After bus-off.. the CAN restarts automatically after 128 groups of 11 recessive bits.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CFG_SJW</name>
              <description>Synchronization Jump Width 1 sjw is less than or equal to tseg1 and sjw is less than or equal to tseg2</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SAMPLING_MODE</name>
              <description>CAN bus bit sampling 0: One sampling point is used in the receiver path. 1: Three sampling points with majority decision are used.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EDGE_MODE</name>
              <description>CAN bus synchronization logic 0: Edge from 'R' to 'D' is used for synchronization. 1: Both edges are used.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ECR</name>
          <description>Error capture register</description>
          <addressOffset>0x01C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>FIELD</name>
              <description>This specifies the field of the ECR 0x00: Stopped 0x01: Synchronize 0x05: Interframe 0x06: Bus idle 0x07: Start of frame 0x08: Arbitration 0x09: Control 0x0A: Data 0x0B: CRC 0x0C: ACK 0x0D: End of frame 0x10: Error flag 0x11: Error echo 0x12: Error delimiter 0x18: Overload flag 0x19: Overload echo 0x1A: Overload delimiter Others: N/A</description>
              <bitRange>[16:12]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>BIT_NUMBER</name>
              <description>Bit number inside of field</description>
              <bitRange>[11:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RX_MODE</name>
              <description>When asserted.. the CAN controller is the receiver.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TX_MODE</name>
              <description>When asserted.. the CAN controller is the transmitter.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ERROR_TYPE</name>
              <description>Specifies different error types 0: Arbitration loss 1: Bit error 2: Bit stuffing error 3: Acknowledge error 4: Form error 5: CRC error Others: N/A</description>
              <bitRange>[3:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>STATUS</name>
              <description>Status of the ECR register 0: The ECR register captured an error or is in free running mode. 1: The ECR register set to sample the event.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TX_MSG0_CTRL_CMD</name>
          <description>Transmit Message0 buffer control and command register</description>
          <addressOffset>0x020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00800000</resetValue>
          <fields>
            <field>
              <name>WPN_B</name>
              <description>Write protect not In case of control flag bit, 0: Bit[21:16] remain unchanged 1: The write protect is not set and bit[21:16] are modified.. by default. The read back value of this bit is undefined Note: Using the WPN flag enables simple retransmission of the same message by only having to set the TxReq and TxAbort flags without taking care of the special flags. In case of command flag bit, 0: Default and 1: prohibited</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RTR</name>
              <description>RTR; Remote bit. control flag bit 0: Standard message 1: RTR message</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>IDE</name>
              <description>Extended identifier bit; Control flag bit 0: This is a standard format message 1: This is an extended format message</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DLC</name>
              <description>Data length code; Control flag bit Invalid values are transmitted as they are.. but the number of data bytes is limited to eight 0: Message has 0 data bytes 1: Message has 1 data byte ... 8: Message has 8 data bytes 9:15: Message has 8 data bytes</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WPN_A</name>
              <description>Write protect not. In case of control flag bit, 0: Bit[2] remains unchanged. 1: The write protect is not set and Bit[2] is modified.. default. In case of Command flag bit, 0:default, 1: prohibited</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXINTEBL</name>
              <description>Tx interrupt enable; Control flag bit 0: Interrupt is disabled. 1: Interrupt enabled.. successful message transmission sets the TX_MSG flag in the interrupt controller.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXABORT</name>
              <description>Transmit abort request; Command flag bit 0: Idle 1: Requests removal of a pending message. The message is removed the next time an arbitration loss happens. The flag is cleared when the message is removed or when the message wins arbitration. The TxReq flag is cleared at the same time.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXREQ</name>
              <description>Transmit request; Command flag bit Write: 0: Idle. No message transmit request. 1: Message transmit request Note: The Tx message buffer must not be changed while TxReq is 1. Read: 0: TxReq completed 1: TxReq pending</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TX_MSG0_ID</name>
          <description>Transmit Message0 buffer identifier register</description>
          <addressOffset>0x024</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ID</name>
              <description>Transmit message0 buffer identifier (29-bit wide)</description>
              <bitRange>[31:3]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
