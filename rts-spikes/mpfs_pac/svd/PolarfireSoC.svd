              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EDCRC_SE</name>
              <description>EDCRC_SE - Data CRC Error Status Enable (SD mode only)

 1 - enabled
 0 - masked</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EDT_SE</name>
