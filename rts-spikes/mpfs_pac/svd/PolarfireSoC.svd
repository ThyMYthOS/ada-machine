              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>IO_BANK_B5_STATUS</name>
              <description>Power status of IO bank 5</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>IO_BANK_B4_STATUS</name>
