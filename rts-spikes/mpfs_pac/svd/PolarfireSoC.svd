        <register>
          <name>SOFT_RESET_TIP</name>
          <description>Compulsory register for all SCB slaves, facilitating global soft reset.</description>
          <addressOffset>0x800</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>BLOCKID_TIP</name>
              <description>This returns the block type and chip location. The form of BLOCKID = {4'h0, SLVTYPE, CHIPID, SUBID}. SLVTYPE=4'h2 for PCIESS MAIN. CHIPID=4'h0 for PCIESS. SUBID=4'h4 for the MAIN page.</description>
              <bitRange>[31:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>PERIPH_TIP</name>
              <description>This asserts functional reset of the peripheral block. It is asserted and left asserted at power-up. Write 0 Write 1</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>V_MAP_TIP</name>
              <description>Resets all the volatile register bits. Write 0 Write 1</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NV_MAP_TIP</name>
              <description>Resets all the non-volatile register bits (e.g. RW-P bits). Write 0 Write 1</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
