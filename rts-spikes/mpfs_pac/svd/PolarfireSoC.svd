              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TC_SE</name>
              <description>TC_SE - Transfer Complete Status Enable

 1 - enabled
 0 - masked</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CC_SE</name>
              <description>CC_SE - Command Complete Status Enable

 1 - enabled
 0 - masked</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
