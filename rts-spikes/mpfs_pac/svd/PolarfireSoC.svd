<?xml version='1.0' encoding='utf-8'?>
<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_0.xsd">
  <vendor>Microchip</vendor>
  <name>Polarfire SoC</name>
  <version>1.0</version>
  <description>Polarfire SoC Register Description</description>
  <addressUnitBits>8</addressUnitBits>
  <width>64</width>
  <size>64</size>
  <cpu>
    <name>Microchip PolarFire SoC</name>
    <revision>1.0</revision>
    <endian>little</endian>
  </cpu>
  <peripherals>
    <peripheral>
      <name>BUS_ERROR_UNIT_H0</name>
      <description>MSS Bus Error Unit H0</description>
      <baseAddress>0x01700000</baseAddress>
      <access>read-write</access>
      <groupName>CPU_Core_Complex</groupName>
      <registers>
        <register>
          <name>CAUSE</name>
          <description>Cause of error event based on mhpmevent register</description>
          <addressOffset>0x00</addressOffset>
          <size>8</size>
        </register>
        <register>
          <name>VALUE</name>
          <description>Physical address of the error event</description>
          <addressOffset>0x08</addressOffset>
          <size>64</size>
        </register>
        <register>
          <name>ENABLE</name>
          <description>Event enable mask</description>
          <addressOffset>0x10</addressOffset>
          <size>8</size>
        </register>
        <register>
          <name>PLIC_INT</name>
          <description>Platform level interrupt enable mask</description>
          <addressOffset>0x18</addressOffset>
          <size>8</size>
        </register>
        <register>
          <name>ACCRUED</name>
          <description>Accrued event mask</description>
          <addressOffset>0x20</addressOffset>
          <size>8</size>
        </register>
        <register>
          <name>LOCAL_INT</name>
          <description>Local interrupt enable mask</description>
          <addressOffset>0x28</addressOffset>
          <size>8</size>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="BUS_ERROR_UNIT_H0">
      <name>BUS_ERROR_UNIT_H1</name>
      <description>MSS Bus Error Unit H1</description>
      <baseAddress>0x01701000</baseAddress>
      <groupName>CPU_Core_Complex</groupName>
    </peripheral>
    <peripheral derivedFrom="BUS_ERROR_UNIT_H0">
      <name>BUS_ERROR_UNIT_H2</name>
      <description>MSS Bus Error Unit H2</description>
      <baseAddress>0x01702000</baseAddress>
      <groupName>CPU_Core_Complex</groupName>
    </peripheral>
    <peripheral derivedFrom="BUS_ERROR_UNIT_H0">
      <name>BUS_ERROR_UNIT_H3</name>
      <description>MSS Bus Error Unit H3</description>
      <baseAddress>0x01703000</baseAddress>
      <groupName>CPU_Core_Complex</groupName>
    </peripheral>
    <peripheral derivedFrom="BUS_ERROR_UNIT_H0">
      <name>BUS_ERROR_UNIT_H4</name>
      <description>MSS Bus Error Unit H4</description>
      <baseAddress>0x01704000</baseAddress>
      <groupName>CPU_Core_Complex</groupName>
    </peripheral>
    <peripheral>
      <name>CACHE_CTRL</name>
      <description>Cache Controller</description>
      <baseAddress>0x02010000</baseAddress>
      <groupName>CPU_Core_Complex</groupName>
      <registers>
        <register>
          <name>CONFIG</name>
          <description>Information on the configuration of the L2 cache</description>
          <addressOffset>0x000</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>BANKS</name>
              <description>Number of banks in the cache</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
              <resetValue>4</resetValue>
            </field>
            <field>
              <name>WAYS</name>
              <description>Total number of enabled ways in the cache</description>
              <bitRange>[15:8]</bitRange>
              <access>read-only</access>
              <resetValue>16</resetValue>
            </field>
            <field>
              <name>SETS</name>
              <description>Base-2 logarithm of the number of sets in a cache bank</description>
              <bitRange>[23:16]</bitRange>
              <access>read-only</access>
              <resetValue>9</resetValue>
            </field>
            <field>
              <name>BYTES</name>
              <description>Base-2 logarithm of the number of bytes in a cache blocks</description>
              <bitRange>[31:24]</bitRange>
              <access>read-only</access>
              <resetValue>6</resetValue>
            </field>
          </fields>
        </register>
        <register>
          <name>WAY_ENABLE</name>
          <description>The WayEnable register determines which ways of the L2 cache controller are enabled as cache. Way indexes less than or equal to this register value may be used by the cache.</description>
          <addressOffset>0x008</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
        </register>
        <register>
          <name>ECC_INJECT_ERROR</name>
          <description>The ECCInjectError register can be used to insert an ECC error into either the backing data or meta-data SRAM. This function can be used to test error correction logic, measurement, and recovery.</description>
          <addressOffset>0x040</addressOffset>
          <size>32</size>
          <access>read-write</access>
        </register>
        <register>
          <name>ECC_DIR_FIX_ADDR</name>
          <description>The ECCDirFixAddr register is a Read-Only register which contains the address of the most recently corrected metadata error. This field only supplies the portions of the address which correspond to the affected set and bank, because all ways are corrected together.</description>
          <addressOffset>0x100</addressOffset>
          <size>64</size>
          <access>read-only</access>
        </register>
        <register>
          <name>ECC_DIR_FIX_COUNT</name>
          <description />
          <addressOffset>0x108</addressOffset>
          <size>32</size>
          <access>read-only</access>
        </register>
        <register>
          <name>ECC_DATA_FIX_ADDR</name>
          <description />
          <addressOffset>0x140</addressOffset>
          <size>64</size>
          <access>read-only</access>
        </register>
        <register>
          <name>ECC_DATA_FIX_COUNT</name>
          <description />
          <addressOffset>0x148</addressOffset>
          <size>32</size>
          <access>read-only</access>
        </register>
        <register>
          <name>ECC_DATA_FAIL_ADDR</name>
          <description />
          <addressOffset>0x160</addressOffset>
          <size>64</size>
          <access>read-only</access>
        </register>
        <register>
          <name>ECC_DATA_FAIL_COUNT</name>
          <description />
          <addressOffset>0x168</addressOffset>
          <size>32</size>
          <access>read-only</access>
        </register>
        <register>
          <name>FLUSH64</name>
          <description />
          <addressOffset>0x200</addressOffset>
          <size>64</size>
          <access>write-only</access>
        </register>
        <register>
          <name>FLUSH32</name>
          <description />
          <addressOffset>0x240</addressOffset>
          <size>32</size>
          <access>write-only</access>
        </register>
        <register>
          <name>WAY_MASK_DMA</name>
          <description />
          <addressOffset>0x800</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_AXI4_SLAVE_PORT_0</name>
          <description />
          <addressOffset>0x808</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_AXI4_SLAVE_PORT_1</name>
          <description />
          <addressOffset>0x810</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_AXI4_SLAVE_PORT_2</name>
          <description />
          <addressOffset>0x818</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_AXI4_SLAVE_PORT_3</name>
          <description />
          <addressOffset>0x820</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_E51_DCACHE</name>
          <description />
          <addressOffset>0x828</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_E51_ICACHE</name>
          <description />
          <addressOffset>0x830</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_U54_1_DCACHE</name>
          <description />
          <addressOffset>0x838</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_U54_1_ICACHE</name>
          <description />
          <addressOffset>0x840</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_U54_2_DCACHE</name>
          <description />
          <addressOffset>0x848</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_U54_2_ICACHE</name>
          <description />
          <addressOffset>0x850</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_U54_3_DCACHE</name>
          <description />
          <addressOffset>0x858</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_U54_3_ICACHE</name>
          <description />
          <addressOffset>0x860</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_U54_4_DCACHE</name>
          <description />
          <addressOffset>0x868</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
        <register>
          <name>WAY_MASK_U54_4_ICACHE</name>
          <description />
          <addressOffset>0x870</addressOffset>
          <size>64</size>
          <access>read-write</access>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MMUART0_LO</name>
      <description>MMUART0_LO Controller</description>
      <baseAddress>0x20000000</baseAddress>
      <registers>
        <register>
          <name>RBR</name>
          <description>Receiver buffer register</description>
          <addressOffset>0x000</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RBR</name>
              <description>This register holds the receive data bits for MMUART_x. The default value is unknown since the register is loaded with data in the receive FIFO. Bit 0 is the LSB and it is the first bit received. It may be configured as the MSB by configuring the E_MSB_RX bit in the MM1. The divisor latch access bit (DLAB).. bit 7 of LCR.. must be 0 to read this register. This register is read only. Writing to this register with the DLAB 0 changes the transmit holding register (THR) register value.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IER</name>
          <description>Interrupt enable register</description>
          <addressOffset>0x004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>EDSSI</name>
              <description>Modem status interrupt enable 0: Disabled (default) 1: Enabled</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ELSI</name>
              <description>Receiver line status interrupt enable 0: Disabled (default) 1: Enabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ETBEI</name>
              <description>Transmitter holding register empty interrupt enable 0: Disabled (default) 1: Enabled</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ERBFI</name>
              <description>Enables received data available interrupt 0: Disabled (default) 1: Enabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IIR</name>
          <description>Interrupt identification register</description>
          <addressOffset>0x008</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x000000C1</resetValue>
          <fields>
            <field>
              <name>MODE</name>
              <description>Always 0b11. Enables FIFO mode.</description>
              <bitRange>[7:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>IIR</name>
              <description>Interrupt identification bits. 0b0110: Highest priority. Receiver line status interrupts due to overrun error.. parity error.. framing error.. or break interrupt. Reading the line status register resets this interrupt. 0b0100: Second priority. Receive data available interrupt modem status interrupt. Reading the receiver buffer register (RBR) or the FIFO drops below the trigger level resets this interrupt. 0b1100: Second priority. Character timeout indication interrupt occurs when no characters have been read from the Rx FIFO during the last four character times and there was at least one character in it during this time. Reading the RBR resets this interrupt. 0b0010: Third priority. Transmit holding register empty interrupt. Reading the IIR or writing to the transmit holding register (THR) resets the interrupt. 0b0000: Fourth priority. Modem status interrupt due to clear to send.. data set ready.. ring indicator.. or data carrier detect being asserted. Reading the modem status register resets this interrupt. 0b0011: Fifth priority. Multi-mode interrupts can occur due to any of the interrupts mentioned in IIM. For more details refer to Table 12-15.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCR</name>
          <description>Line control register</description>
          <addressOffset>0x00C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DLAB</name>
              <description>Divisor latch access bit. Enables access to the divisor latch registers during read or write operation to address 0 and 1. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SB</name>
              <description>Set break. Enabling this bit sets MMUART_x_TXD to 0. This does not have any effect on transmitter logic. The break is disabled by setting the bit to 0. 0: Disabled (default) 1: Set break</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SP</name>
              <description>Stick parity 0: Disabled (default) 1: Enabled When stick parity is enabled.. the parity is set according to bits [4:3] as follows: 11: 0 will be sent as a parity bit and checked when receiving. 01: 1 will be sent as a parity bit and checked when receiving.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EPS</name>
              <description>Even parity select 0: Odd parity (default) 1: Even parity</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PEN</name>
              <description>Parity enable 0: Disabled 1: Enabled. Parity is added in transmission and checked in receiving.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>STB</name>
              <description>Number of stop bits (STB) 0: 1 stop bit (default) 1: 11/2 stop bits when WLS=00 The number of stop bits is 2 for all other cases not described above (STB=1 and WLS=01.. 10.. or 11).</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WLS</name>
              <description>Word length select 0b00: 5 bits (default) 0b01: 6 bits 0b10: 7 bits 0b11: 8 bits</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MCR</name>
          <description>Modem control register</description>
          <addressOffset>0x010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RLOOP</name>
              <description>Remote loopback enable bits. In the Remote loopback mode.. when a bit is received.. it is sent directly out the transmit line.. bypassing the transmitter block.. and disabling the receiver. In the Automatic echo mode.. when a bit is received.. it is sent directly out the transmit line.. bypassing the transmitter block.. while the receiver is still enabled. 00: Disabled (default) 01: Remote loopback enabled 10: Automatic echo enabled 11: Reserved Note: Local loopback mode has priority over the remote/echo loopback modes.</description>
              <bitRange>[6:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LOOP</name>
              <description>In the Loopback mode.. MMUART_x_TXD is set to 1. The MMUART_x_RXD.. MMUART_x_DSR.. MMUART_x_CTS.. MMUART_x_RI.. and MMUART_x_DCD inputs are disconnected. The output of the transmitter shift register is looped back into the receiver shift register. The modem control outputs (MMUART_x_DTR.. MMUART_x_RTS.. MMUART_x_OUT1.. and MMUART_x_OUT2) are connected internally to the modem control inputs.. and the modem control output pins are set as 1. The transmitted data is immediately received.. allowing Cortex-M3 processor to check the operation of the MMUART_x. The interrupts are operating in the Loopback mode. 0: Disabled (default) 1: Local loopback enabled Note: The local loopback mode has priority over the remote loopback modes. LOOPBACK is only implemented in basic UART mode. It does function in LIN IRDA or Smart card modes.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>OUT2</name>
              <description>Controls the output2 (OUT2) signal. Active Low 0: OUT2n is less than equal to 1 (default) 1: OUT2n is less than equal to 0</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>OUT1</name>
              <description>Controls the output1 (OUT1) signal. Active Low 0: OUT1n is less than equal to 1 (default) 1: OUT1n is less than equal to 0</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RTS</name>
              <description>Controls the request to send (MMUART_x_RTS) signal. Active Low 0: RTSn is less than equal to 1 (default) 1: RTSn is less than equal to 0</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DTR</name>
              <description>Data terminal ready (MMUART_x_DTR) output. Active Low 0: DTRn is less than or equal to 1 (default) 1: DTRn is less than or equal to 0</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LSR</name>
          <description>Line status register</description>
          <addressOffset>0x014</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000060</resetValue>
          <fields>
            <field>
              <name>FIER</name>
              <description>This bit is set when there is at least one parity error.. framing error.. or break indication in the FIFO. FIER is cleared when Cortex-M3 processor reads the LSR.. if there are no subsequent errors in the FIFO.</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TEMT</name>
              <description>Transmit empty (TEMT). This bit is set to 1 when both the transmitter FIFO and shift registers are empty.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>THRE</name>
              <description>Transmitter holding register empty (THRE). Indicates that the MMUART_x is ready to transmit a new data byte. THRE causes an interrupt to the Cortex-M3 processor when bit 1 (ETBEI) in the interrupt enable register is 1. This bit is set when the Tx FIFO is empty. It is cleared when at least one byte is written to the Tx FIFO.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>BI</name>
              <description>Break interrupt (BI). Indicates that the receive data is at 0 longer than a full word transmission time (start bit + data bits + parity + stop bits). BI is cleared when Cortex-M3 processor reads the line status register (LSR). This error is revealed to the Cortex-M3 processor when it is associated character is at the top of the FIFO. When break occurs.. only one zero character is loaded into the FIFO.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>FE</name>
              <description>Framing error (FE). Indicates that the receive byte did not have a valid stop bit. FE is cleared when Cortex-M3 processor reads the LSR. The MMUART_x tries to resynchronize after a framing error. To do this.. it assumes that the framing error was due to the next start bit.. so it samples this start bit twice.. and then starts receiving the data. This error is revealed to Cortex-M3 processor when it is associated character is at the top of the FIFO.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>PE</name>
              <description>Parity error (PE). Indicates that the receive byte had a parity error. PE is cleared when the Cortex-M3 processor reads the LSR. This error is revealed to the Cortex-M3 processor when it is associated character is at the top of the FIFO.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>OE</name>
              <description>Overrun error (OE). Indicates that the new byte was received before the Cortex-M3 processor reads the byte from the receive buffer.. and that the earlier data byte was destroyed. OE is cleared when the Cortex-M3 processor reads the LSR. If the data continues to fill the FIFO beyond the trigger level.. an overrun error occurs once the FIFO is full and the next character has been completely received in the shift register. The character in the shift register is overwritten.. but it is not transferred to the FIFO.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DR</name>
              <description>Data ready (DR). 1: Indicates when a data byte is received and stored in the receive buffer or the FIFO. DR is cleared to 0 when the Cortex-M3 processor reads the data from the receive buffer or the FIFO.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MSR</name>
          <description>Modem status register</description>
          <addressOffset>0x018</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DCD</name>
              <description>Data carrier detect (DCD) (MMUART_x_DCD).The complement of DCD input. When bit 4 of the MCR is set to 1 (loop).. this bit is equivalent to OUT2 in the MCR.</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RI</name>
              <description>Ring indicator (RI) (MMUART_x_RI). The complement of the RI input. When bit 4 of the MCR is set to 1 (loop).. this bit is equivalent to OUT1 in the MCR.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DSR</name>
              <description>Data set ready (DSR) (MMUART_x_DSR). The complement of the DSR input. When bit 4 of the MCR is set to 1 (loop).. this bit is equivalent to RTS in the MCR.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>CTS</name>
              <description>Clear to send (CTS) (MMUART_x_CTS). The complement of the CTS input. When bit 4 of the MCR is set to 1 (loop).. this bit is equivalent to DTR in the MCR.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DDCD</name>
              <description>Delta data carrier detect (DDCD) indicator. Indicates that DCD input has changed state. Whenever bit 0.. 1.. 2.. or 3 is set to 1.. a modem status interrupt is generated.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TERI</name>
              <description>Trailing edge of ring indicator (TERI) detector. Indicates that RI input has changed from 0 to 1. Whenever bit 0.. 1.. 2.. or 3 is set to 1.. a modem status interrupt is generated.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DDSR</name>
              <description>Delta data set ready (DDSR) indicator. Indicates that the DSRn input has changed state since the last time it was read by the Cortex-M3 processor. Whenever bit 0.. 1.. 2.. or 3 is set to 1.. a modem status interrupt is generated.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DCTS</name>
              <description>Delta clear to send (DCTS) indicator. Indicates that the CTSn input has changed state since the last time it was read by the Cortex-M3 processor. Whenever bit 0.. 1.. 2.. or 3 is set to 1.. a modem status interrupt is generated.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SR</name>
          <description>Scratch register</description>
          <addressOffset>0x01C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SCR</name>
              <description>Scratch register. This register has no effect on MMUART_x operation.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>Reserved</name>
          <description>Reserved register</description>
          <addressOffset>0x020</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED1</name>
              <description />
              <bitRange>[31:8]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IEM</name>
          <description>Multi-mode interrupt enable register</description>
          <addressOffset>0x024</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ELINSI</name>
              <description>Enables the LIN sync detection interrupt. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ELINBI</name>
              <description>Enables LIN break interrupt. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EPID_PEI</name>
              <description>Enables PID parity error interrupt 0: Disabled (default) 1: Enabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENACKI</name>
              <description>Enables NACK interrupt. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ERTOI</name>
              <description>Enables receiver timeout interrupt. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IIM</name>
          <description>Multi-mode interrupt identification register</description>
          <addressOffset>0x028</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>LINSI</name>
              <description>LIN sync detection interrupt ID. This bit set when 5th falling edge is detected by the sync timer. It resets the FIFO address pointers so that the PID will be in the first location. Reading the IIM register clears this interrupt.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LINBI</name>
              <description>LIN break interrupt.. set automatically when break length of 11.5 Tbits is detected. Reading the IIM register clears this interrupt.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PID_PEI</name>
              <description>Protected identifier field (PID) parity error interrupt is generated when there is a mismatch in PID in LIN header.. that is.. when either the P0 or P1 bits in the incoming PID byte do not match the calculated P0 and P1 error.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>NACKI</name>
              <description>NACK interrupt is asserted when EERR bit is set in MM2. Reading the MM2 clears the interrupt.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RTOII</name>
              <description>Receiver time-out (RTO) interrupt ID. RTO interrupt is asserted when RTO value is reached by the counter. It gets cleared when writing to the RTO register.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>Reserved_1</name>
          <description />
          <addressOffset>0x02C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED1</name>
              <description />
              <bitRange>[31:8]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MM0</name>
          <description>Multi-mode control register0</description>
          <addressOffset>0x030</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>EFBR</name>
              <description>Enable fractional baud rate (FBR) mode. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ERTO</name>
              <description>Enable receiver timeout (RTO). Writing this bit enables the timeout and restarts the counter value. The timeout value is determined by the RTO register. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ETTG</name>
              <description>Enable transmitter time guard (TTG). The time guard value is determined by the TTG Register. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ELIN</name>
              <description>Enable LIN header detection and automatic baud rate calculation. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ESYN</name>
              <description>Enable synchronous operation. There are four types of Synchronous Operation modes that can be enabled. 0b000: Disabled.. that is.. Asynchronous mode (default) 0b001: Synchronous slave enabled.. positive-edge clock 0b010: Synchronous slave enabled.. negative-edge clock 0b011: Synchronous master enabled.. positive-edge clock 0b100: Synchronous master enabled.. negative-edge clock 0b101.. 0b110.. and 0b111: Reserved</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MM1</name>
          <description>Multi-mode control register1</description>
          <addressOffset>0x034</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>EITP</name>
              <description>Output pulse width for RZI mod can be modified using this bit. 0: 3/16th Tbit pulse width (default). 1: 1/4th Tbit pulse width.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EITX</name>
              <description>You can configure output polarity for RZI modulation. 0: RZI output pulses are active Low and signify a low NRZ value (default). 1: RZI output pulses are active High and signify a high NRZ value.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EIRX</name>
              <description>You can configure input polarity for RZI demodulation. 0: RZI input pulses are active Low.. signifying a low NRZ value (default). 1: RZI input pulses are active High.. signifying a high NRZ value.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EIRD</name>
              <description>Enables RZI modulation/demodulation. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>E_MSB_TX</name>
              <description>LSB or MSB can be sent first by configuring this bit. By default.. the "THR" bit 0 is the LSB.. and is the first transmitted bit. Bit 0 of the THR may be configured as the last transmitted bit.. MSB. 0: THR's bit 0 is the first transmitted bit.(LSB). (default). 1: THR's bit 0 is the last transmitted bit.(MSB).</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>E_MSB_RX</name>
              <description>LSB or MSB can be received first by configuring this bit. By default.. the receiver buffer register's (RBR) bit 0 is the LSB.. and is the first received bit. Bit 0 of the RBR may be configured as the last received bit.. MSB. 0: RBR's bit 0 is the first received bit(LSB). (default). 1: RBR's bit 0 is the last received bit(MSB).</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MM2</name>
          <description>Multi-mode control register2</description>
          <addressOffset>0x038</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ESWM</name>
              <description>Enable single-wire.. half-duplex mode. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EAFC</name>
              <description>Enable a address flag clear (EAFC). When EAFM is enabled the Rx FIFO is disabled until another address flag with matching address is received. The bit gets cleared on write in multi-mode control registers 2. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EAFM</name>
              <description>Enable automatic 9-bit address flag mode (EAFM). It should be noted that for enabling this bit it requires.. the LCR should be in an 8-bit and stick parity (SP) bit configured to 0. If EAFM bit is disabled.. the Rx FIFO is enabled by receiving all the bytes. When EAFM bit is enabled.. the Rx FIFO is disabled until an address flag with matching address is received. Note: If an address match occurs and the Rx FIFO is enabled then it can be disabled.. if either another address flag occurs or there is a mismatch or the EAFC bit is set. In either case.. the Address flag compare will continue as long as the EAFM bit is set. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EERR</name>
              <description>When the EERR bit is set.. the receiver forces an error signal transmit out.. if an incoming parity error is detected. Error signal (ACK/NACK) is sent during stop time enable. Note: The EERR only applies in an 8-bit data length.. 2 stop bit configuration. Error signal occurs during the last 1.5 stop bits as per Figure 12-18 on page 529. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DFR</name>
          <description>Fractional divisor register</description>
          <addressOffset>0x03C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DFR</name>
              <description>The fractional divisor register (DFR) is used to store the fractional divisor used to calculate the fractional baud rate value in 1/64th using EQ 5. 0x0: 0/64 0x1: 1/64 .... 0x3F: 63/64</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GFR</name>
          <description>Glitch filter register</description>
          <addressOffset>0x044</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>GLR</name>
              <description>The glitch filter resynchronizes (GLR) and suppresses random input noise from MMUART_x_RXD (serial input data) and MMUART_x_SCK_IN (serial input clock in synchronous mode) based on the filter length given in number system clock cycles. The following are the different filter lengths in the APB clock cycles that can be written into the GLR register and their description. 0b000: Two resynchronize flip-flops are used but there is no spike suppression. 0b001: Three resynchronize flip-flops are used but there is no spike suppression. 0b010: Three resynchronize flip-flops are used and it also causes 1 APB clock cycle suppression. 0b011: Three resynchronize flip-flops are used and it also causes 2 APB clock cycle suppression. 0b100: Three resynchronize flip-flops are used and it also causes 3 APB clock cycle suppression. 0b101: Three resynchronize flip-flops are used and it also causes 4 APB clock cycle suppression. 0b110: Three resynchronize flip-flops are used and it also causes 5 APB clock cycle suppression. 0b111: Three resynchronize flip-flops are used and it also causes 6 APB clock cycle suppression.</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TTG</name>
          <description>Transmitter time guard register</description>
          <addressOffset>0x048</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TTG</name>
              <description>If the transmitter time guard is enabled from the multi-mode control register 0 (MM0).. the transmitter time guard value determines the amount of system clock cycles to wait between transmissions. The time guard equation is based on the baud rate bit time (Tbit) value as follows: Tx Time Guard Value = TTG x Bit Time (Tbit)</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RTO</name>
          <description>Receiver time-out register</description>
          <addressOffset>0x04C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RTO</name>
              <description>Writing to the RTO register sets the counter value and enables.. if the ERTO bit in the MM0 is enabled. You can configure the timeout value by writing into this register. The RTO counts when the Rx block input state is idle; is reset when a start condition occurs.. and restarts counting upon returning to the idle state. When the RTO value is reached.. the RTOII interrupt is set. Re-writing the RTO register clears the interrupt and sets the counter. The receiver timeout value equation is based on the baud rate bit time (Tbit) as follows: Rx Timeout Value = 4 x RTO x Bit Time (Tbit)</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ADR</name>
          <description>Address register</description>
          <addressOffset>0x050</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADR</name>
              <description>The address register is used in 9-bit Address Flag mode. When an address flag is received on the 9th bit.. and EAFM is set in MM2.. the incoming data is checked against the address register. If a match occurs.. the Rx FIFO is enabled.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DLR</name>
          <description>Divisor latch (LSB)</description>
          <addressOffset>0x080</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <fields>
            <field>
              <name>DLR</name>
              <description>This divisor latch LSB register (DLR) holds the LSB of the integer divisor value used to calculate the baud rate. The baud rate can be calculated using EQ 1.. 2.. 3.. or 4. ** To access this Register DAP (bit7) of Line Control Register (LCR) should be set.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMR</name>
          <description>Divisor latch (MSB)</description>
          <addressOffset>0x084</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DMR</name>
              <description>This divisor latch MSB register (DMR) holds the MSB of the integer divisor value used to calculate the baud rate. The baud rate can be calculated using EQ 1.. 2.. 3.. or 4. ** To access this Register DAP (bit7) of Line Control Register (LCR) should be set.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>THR</name>
          <description>Transmit holding register</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>THR</name>
              <description>This register holds the data bits to be transmitted. Bit 0 is the LSB and is transmitted first. The MSB may be transmitted first.. if it is configured with the E_MSB_TX bit in the MM1. The reset value is unknown since the register is loaded with data in the transmit FIFO. The DLAB.. bit 7 of LCR.. must be 0 to write to this register. This register is write only. Reading from this register with the DLAB 0 reads the RBR register value.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FCR</name>
          <description>FIFO control register</description>
          <addressOffset>0x108</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x000000C1</resetValue>
          <fields>
            <field>
              <name>RX_TRIG</name>
              <description>These bits are used to set the trigger level for the Rx FIFO interrupt. Rx FIFO trigger level (bytes) are: 0b00: 1 byte 0b01: 4 bytes 0b10: 8 bytes 0b11: 14 bytes</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENABLE_TXRDY_RXRDY</name>
              <description>Switches between RXRDY and TXRDY mode 0 and mode 1 functionality. 0-Mode 0. 1-Mode 1</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CLEAR_TX_FIFO</name>
              <description>Clears all bytes in the Tx FIFO and resets its counter logic. The shift register is not cleared. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CLEAR_RX_FIFO</name>
              <description>Clears all bytes in Rx FIFO and resets counter logic. This shift register is not cleared. 0: Disabled (default) 1: Enabled</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENABLE_TX_RX_FIFO</name>
              <description>It enables both the Tx and Rx FIFOs and is hardwired to 1.. which means it is always enabled and cannot be changed.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WDOG0_LO</name>
      <description>WDOG0_LO Controller</description>
      <baseAddress>0x20001000</baseAddress>
      <registers>
        <register>
          <name>WDOG_REFRESH</name>
          <description />
          <addressOffset>0x000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00FFFFF0</resetValue>
          <fields>
            <field>
              <name>WDOGREFRESH</name>
              <description>Writing pwdata=0xdeadc0de resets the watchdog timer to start counting down again when in the permitted refresh window. Writes of any other value will have no effect whilst in the permitted refresh window. Reads return the current timer value. A write to this will start the watchdog once started the watchdog cannot be stopped.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDOG_CONTROL</name>
          <description />
          <addressOffset>0x004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <fields>
            <field>
              <name>ENABLE_FORBIDDEN</name>
              <description>When set if a write occurs in the forbidden region the watchdog will trigger</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ACTIVE_SLEEP</name>
              <description>When set the watchdog is operational, when the CPU is sleeping.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTEN_SLEEP</name>
              <description>Enables the MVRP interrupt when the MVRP level is passed and the M3 is sleeping</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTEN_TRIG</name>
              <description>Enables the NMI interrupt when the TRIGGER level is passed. NOTE: This bit is permanently set and cannot be changed.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTEN_MSVP</name>
              <description>Enables the MVRP interrupt when the MVRP level is passed</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDOG_STATUS</name>
          <description />
          <addressOffset>0x008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DEVRST</name>
              <description>Indicates that the DEVRST caused the NMI. Will be cleared when the system resets</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>LOCKED</name>
              <description>Indicates that the following three registers are locked and cannot be changed</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TRIGGERED</name>
              <description>Indicates that the watchdog has triggered. Will be cleared when the system resets</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>FORBIDDEN</name>
              <description>Indicates that the watchdog is currently in the forbidden range</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>WDOG_TRIPPED</name>
              <description>Indicates that the TRIGGER level has passed and that the NMI is asserted, Cleared by writing a '1'</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MVRP_TRIPPED</name>
              <description>Indicates that the MVRP level has passed. Cleared by writing a '1'</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDOG_TIME</name>
          <description />
          <addressOffset>0x00C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00FFFFF0</resetValue>
          <fields>
            <field>
              <name>WDOGTIME</name>
              <description>Sets the watchdog time value. Once written locks this and the following two registers</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MSVP</name>
          <description />
          <addressOffset>0x010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00989680</resetValue>
          <fields>
            <field>
              <name>WDOGMVRP</name>
              <description>Sets the watchdog MVRP value.</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TRIGGER</name>
          <description />
          <addressOffset>0x014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000003E8</resetValue>
          <fields>
            <field>
              <name>WDOGTRIG</name>
              <description>Sets the watchdog trigger value, 0-4095 u seconds</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FORCE</name>
          <description />
          <addressOffset>0x018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>WDOGVALUE</name>
              <description>If the watchdog has triggered writing 0x0c will cause an immediate reset, any other value or write at other times will trigger the watchdog NMI sequence.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SYSREG</name>
      <description>SYSREG Controller</description>
      <baseAddress>0x20002000</baseAddress>
      <registers>
        <register>
          <name>TEMP0</name>
          <description>Register for software use</description>
          <addressOffset>0x000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000AC7E1</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Scratch register for CPUS</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TEMP1</name>
          <description>Register for software use</description>
          <addressOffset>0x004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Scratch register for CPUS</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CLOCK_CONFIG_CR</name>
          <description>Master clock configuration</description>
          <addressOffset>0x008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000010</resetValue>
          <fields>
            <field>
              <name>CAN_CLOCK_FABRIC</name>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MMC_CLOCK_FABRIC</name>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENABLE_1MHZ</name>
              <description>When '1' requests pfsoc_control to enable the 1mHz (2MHz) on-chip oscillator</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DIVIDER_APB_AHB</name>
              <description>Sets the master synchronous clock divider AHB/APB clock divider (Reset=/2 =1) 00=/1 01=/2 10=/4 11=/8 (AHB/APB divider may not be set to /1)</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DIVIDER_AXI</name>
              <description>Sets the master synchronous clock divider for AXI clock divider (Reset=/1 =0)</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DIVIDER_CPU</name>
              <description>Sets the master synchronous clock divider for CPU (Reset=/1 =0). Note at reset MSS corner clock is 80MHz, therefore divider is set to divide by 1</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RTC_CLOCK_CR</name>
          <description>RTC clock divider</description>
          <addressOffset>0x00C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00010064</resetValue>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>RTC Clock enable. When chaning the divider the enable should be trurned off first, the divider changed and the enable turned back on.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PERIOD</name>
              <description>Sets the division ratio to create the internal RTC clock from the reference clock. The defaults sets the reference clock to 1MHz assuming the reference clock is 100Mhz. If the reference clock is 125MHz then 125 will create a 1MHz clock Max divider value is 4095 and value must be an integer. RTC clock must be less 2X the AXI clock rate.</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FABRIC_RESET_CR</name>
          <description>Fabric Reset mask</description>
          <addressOffset>0x010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>This bitfield has no affect if changed</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BOOT_FAIL_CR</name>
          <description />
          <addressOffset>0x014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>BOOT</name>
              <description>Written by firmware to indicate that the boot process failed, drives the fab_boot_fail signal to the fabric. Is cleared by the fabric asserting fab_boot_fail_clear</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MSS_RESET_CR</name>
          <description>Allows the CPU to fully reset the MSS</description>
          <addressOffset>0x018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESET_VALUE</name>
              <description>When written to 16'hDEAD will cause a full MSS reset. The Reset wil clear this register. The register may be writtent to any value but only a value off 16'hDEAD will cause the reset to happen</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CONFIG_LOCK_CR</name>
          <description>Configuration lock</description>
          <addressOffset>0x01C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>LOCK</name>
              <description>When written to '1' will cause all RWC registers to lock until a master reset occurs.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RESET_SR</name>
          <description>Indicates which reset caused the last reset. After a reset occurs register should be read and then zero written to allow the next reset event to be correctly captured.</description>
          <addressOffset>0x020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000001FF</resetValue>
          <fields>
            <field>
              <name>CPU_SOFT_RESET</name>
              <description>Indicates that the CPU reset ths MSS using the soft reset register</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SCB_BUS_RESET</name>
              <description>Indicates that SCB bus reset occurred (which causes warm reset of MSS)</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>GPIO_RESET</name>
              <description>Indicates that fabric asserted the GPIO reset inputs</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WDOG_RESET</name>
              <description>Reset was caused by the watchdog</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FABRIC_RESET</name>
              <description>Reset was caused by the fabric</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DEBUGER_RESET</name>
              <description>Reset was caused by the Risc-V Debugger</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SCB_CPU_RESET</name>
              <description>Reset was caused by the SCB CPU reset register</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SCB_MSS_RESET</name>
              <description>Reset was caused by the SCB MSS reset register</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SCB_PERIPH_RESET</name>
              <description>Reset was caused by the SCB periphery reset signal</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVICE_STATUS</name>
          <description>Indicates the device status, in particular the state of the FPGA fabric and the MSS IO banks</description>
          <addressOffset>0x024</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>IO_EN</name>
              <description>Indicates the status of the io_en input from G5 Control.</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>IO_BANK_B6_STATUS</name>
