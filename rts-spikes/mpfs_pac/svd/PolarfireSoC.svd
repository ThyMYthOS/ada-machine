          <resetValue>0x502E2745</resetValue>
          <fields>
            <field>
              <name>AXI_PROT_VALUE</name>
              <description>Takes the value of the edma_axi_prot_value parameter which is set by the 'gem_axi_prot_value DEFINE but will be zero if the FIFO interface has been configured</description>
              <bitRange>[31:29]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TSU_CLK</name>
              <description>Takes the value of the 'gem_tsu_clk DEFINE</description>
