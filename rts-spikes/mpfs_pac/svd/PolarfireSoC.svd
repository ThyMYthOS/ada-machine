            </field>
            <field>
              <name>SEQRST_COUNT</name>
              <description>Count of number of times the sequence recovery reset timer decrements to zero.</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_15_10</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[15:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>OUT_OF_ORDER</name>
