              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CFG_RFC1</name>
          <description />
          <addressOffset>0x03C94</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000022</resetValue>
          <fields>
            <field>
