    <peripheral>
      <name>IOSCBCFG</name>
      <description>IOSCBCFG Controller</description>
      <baseAddress>0x37080000</baseAddress>
      <registers>
        <register>
          <name>CONTROL__1</name>
          <description />
          <addressOffset>0x000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SCBCLOCK_ON</name>
              <description>Setting this requests PFC to turn on the SCB clock permanently</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESET_CYCLE</name>
              <description>Writing a '1' to the bit will cause a reset off the internal FSMS. Once set it will stay asserted until the reset cycle completes when it will be cleared. This may take several clock cycles depending on relative speeds of the SCB and AHB clocks.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTEN_BUSERR</name>
              <description>Enables interrupt when SCB bus error detected</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTEN_TIMEOUT</name>
              <description>Enables interrupt when timeout occurs</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTEN_ERROR</name>
              <description>Enables interrupt when SCB error asserted</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTEN_SCB</name>
              <description>Enables interrupt when SCB Interrupt asserted</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>STATUS</name>
          <description />
          <addressOffset>0x004</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SCB_BUSERR</name>
              <description>Indicated that an SCB bus error (parity) was detected. Is cleared by initiating FSM reset cycle (Control register bit 16)</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TIMEOUT</name>
              <description>Indicated that the SCB access timed out. Is cleared by initiating FSM reset cycle (Control register bit 16)</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SCB_ERROR</name>
              <description>Indicates that the SCB error was asserted. Is cleared by initiating FSM reset cycle (Control register bit 16)</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SCB_INTERRUPT</name>
              <description>Indicated SCB interrupt active. Is cleared by clearing the SCB interrupt source</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMER</name>
          <description />
          <addressOffset>0x008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00002080</resetValue>
          <fields>
            <field>
              <name>REQUEST_TIME</name>
              <description>Sets how long SCB request is held active after SCB bus granted. Allows SCB bus mastership to maintained across multiple SCB access cycles</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TIMEOUT</name>
              <description>Set the timeout for an SCB access in CPU cycles.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
