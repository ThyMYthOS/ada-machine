              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[15:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>LATENT_ERRORS</name>
              <description>Count of sequence numbers seen without a duplicate. The latent error count is updated when a frame is dropped from the history vector. So the update only happens after a new frame is received.</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_statistics_2_b</name>
          <description>FRER statistics register B. This register is cleared on a read and does not roll over if its maximum value is reached.</description>
          <addressOffset>0x08DC</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_24</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SEQRST_COUNT</name>
              <description>Count of number of times the sequence recovery reset timer decrements to zero.</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_15_10</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[15:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>OUT_OF_ORDER</name>
              <description>Count of out of order sequence numbers received. Incremented when a frame is accepted but the sequence number is not +1 of the highest stored value.</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_control_3_a</name>
          <description>FRER control register A</description>
          <addressOffset>0x08E0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>EN_ELIMINATION</name>
              <description>Enable 802.1CB elimination of received frames</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_VECTOR_REC_ALG</name>
              <description>Enable 802.1CB vector recovery algorithm, : 0 enables the match recovery algorithm, : 1 enables the vector recovery algorithm, :This bit should only be changed when bit 31 en_elimination is low</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_SEQRECRST_TIMER</name>
              <description>Enable 802.1CB sequence recovery reset timer - this bit may be changed when bit 31 en_elimination is low</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USE_R_TAG</name>
              <description>Set to one to use redundancy tag to identify sequence number otherwise use offset value to identify bottom of sequence number - this bit should only be changed when bit 31 en_elimination is low</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_27_17</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[27:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>OFFSET_VALUE</name>
              <description>Offset value in bytes from the start packet delimiter to the most significant byte of the 802.1CB sequence number - 9 bits allow a maximum value of 511 - allowing a TCP sequence number to be used with IPv6 - this bit should only be changed when en_elimination is low</description>
              <bitRange>[16:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MEMBER_STREAM_2</name>
              <description>Pointer to screener type 2 register used for member stream identification. The member stream 1 and 2 values may be programmed to identical values. - this bit should only be changed when en_elimination is low</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MEMBER_STREAM_1</name>
              <description>Pointer to screener type 2 register used for member stream identification. The member stream 1 and 2 values may be programmed to identical values. - this bit should only be changed when en_elimination is low</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_control_3_b</name>
          <description>FRER control register B. This register has default values where the sequence number length defaults to 16 and the vector recovery window defaults to the size of the history vector. It is not expected that the user will need to change these default values.</description>
          <addressOffset>0x08E4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_13</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:13]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SEQ_NUM_LENGTH</name>
              <description>Number of significant bits of the 802.1CB sequence number. The value 0x00 or numbers greater than 16 bits are equivalent to 16, but the number written will still be read back if it is greater than 16. If a value of less than 16 is written, then the sequence recovery algorithm will only consider that number of LSBs of the sequence number. The minimum size of seq_num_length has to be such that 2^seq_num_len is at least 2xgem_seq_history_len otherwise the vector recovery algorithm will not work correctly - this bit should only be changed when en_elimination is low</description>
              <bitRange>[12:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_7_6</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[7:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SEQ_REC_WINDOW</name>
              <description>Vector recovery window, defines the window size used by the vector recovery algorithm to determine whether to reject a packet. Six bits allow a window size of 63, for effective operation of FRER users should not write a value greater than the gem_seq_history_len configuration define, a value of zero means the entire history vector is used - this bit should only be changed when en_elimination is low.</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_statistics_3_a</name>
          <description>FRER statistics register A. This register is cleared on a read and does not roll over if its maximum value is reached.</description>
          <addressOffset>0x08E8</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_26</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:26]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>VEC_REC_ROGUE</name>
              <description>Count of number of frames dropped by the vector recovery algorithm for being out of range</description>
              <bitRange>[25:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_15_10</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[15:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>LATENT_ERRORS</name>
              <description>Count of sequence numbers seen without a duplicate. The latent error count is updated when a frame is dropped from the history vector. So the update only happens after a new frame is received.</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_statistics_3_b</name>
          <description>FRER statistics register B. This register is cleared on a read and does not roll over if its maximum value is reached.</description>
          <addressOffset>0x08EC</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
