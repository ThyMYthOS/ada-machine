              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CRC_ERR_INT_ENBL</name>
              <description>CRC error interrupt enable.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FORM_ERR_INT_ENBL</name>
              <description>Format error interrupt enable.</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ACK_ERR_INT_ENBL</name>
              <description>Acknowledge error interrupt enable.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>STUFF_ERR_INT_ENBL</name>
              <description>Bit stuffing error interrupt enable.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BIT_ERR_INT_ENBL</name>
              <description>Bit error interrupt enable.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>OVR_LOAD_INT_ENBL</name>
              <description>Overload message detected interrupt enable.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ARB_LOSS_INT_ENBL</name>
              <description>Arbitration loss interrupt enable.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INT_ENBL</name>
              <description>Global interrupt enable flag. 0: All interrupts are disabled 1: Enabled interrupt sources are available</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
