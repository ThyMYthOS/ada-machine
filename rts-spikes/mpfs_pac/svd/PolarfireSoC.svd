        <register>
          <name>designcfg_debug4</name>
          <description>Design Configuration Register 4</description>
          <addressOffset>0x028C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
