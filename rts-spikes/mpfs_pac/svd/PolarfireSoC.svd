    <peripheral>
      <name>AXISWITCH15X9_DW_AXI</name>
      <description>AXISWITCH15X9_DW_AXI Controller</description>
      <baseAddress>0x20004000</baseAddress>
      <registers>
        <register>
          <name>AXI_VERSION_ID_REG</name>
          <description>Version ID register</description>
          <addressOffset>0x000</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x3430322A</resetValue>
          <fields>
            <field>
              <name>AXI_VERID_FIELDS</name>
              <description>DW_AXI Version ID Number. ASCII value of each number in component version followed by *. For example, 33_30_30_2A represents the version 3.00*.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AXI_HW_CFG_REG</name>
          <description>Hardware configuration register</description>
          <addressOffset>0x004</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0090F105</resetValue>
          <fields>
            <field>
              <name>AXI_NUM_SLAVES</name>
              <description>Number of AXI Slaves.</description>
              <bitRange>[24:20]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AXI_NUM_MASTERS</name>
              <description>Number of AXI masters</description>
              <bitRange>[16:12]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AXI_LOW_POWER_IF</name>
              <description>Include/exclude low-power interface. 0x1 (REMAP_SUPPORTED): DW_axi- Low-power interface is included. 0x0 (REMAP_NOT_SUPPORTED): DW_axi- Low-power interface is not included.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AXI_BI_DIR_CMD_EN</name>
              <description>Support for Enable Bi-directional Command.0x1 (REMAP_SUPPORTED): DW_axi supports the bi-directional command. 0x0 (REMAP_NOT_SUPPORTED): DW_axi does not support the bi-directional command</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AXI_REMAP_EN</name>
              <description>Support for Enable Remap mode.0x1 (REMAP_SUPPORTED): DW_axi supports Enable Remap mode. 0x0 (REMAP_NOT_SUPPORTED): DW_axi does not support Enable Remap mode</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AXI_DECODER_TYPE</name>
              <description>Use of External/Internal Decoder.0x1 (EXT_DECODER): DW_axi uses external decoder. 0x0 (INT_DECODER): DW_axi does not use the external decoder</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AXI_HWCFG_TRUST_ZONE_EN</name>
              <description>Support for Enable Trust Zone. 0x1 (TZEN_SUPPORTED): DW_axi-Trust Zone features are Enabled. 0x0 (TZEN_NOT_SUPPORTED): DW_axi-Trust Zone features are Disabled.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AXI_HWCFG_LOCK_EN</name>
              <description>Support for Enable Lock transactions. 0x1 (LOCKEN_SUPPORTED): DW_axi-Locking feature is Enabled. 0x0 (LOCKEN_NOT_SUPPORTED): DW_axi-Locking feature is Disabled</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AXI_HWCFG_AXI4_SUPPORT</name>
              <description>Support for AXI4 features. 0x1 (AXI4_SUPPORTED): DW_axi supports AXI4 features. 0x0 (AXI4_NOT_SUPPORTED): DW_axi does not support AXI4 features.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AXI_HWCFG_APB3_SUPPORT</name>
              <description>Has APB3 support. 0x1 (APB3_SUPPORTED): DW_axi has APB3 support. 0x0 (APB3_NOT_SUPPORTED): DW_axi does not have APB3 support.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AXI_HWCFG_QOS_SUPPORT</name>
              <description>QOS Support. 0x1 (QOS_ENABLED): DW_axi QOS support is enabled. 0x0 (QOS_DISABLED): DW_axi QOS support is disabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AXI_CMD_REG</name>
          <description>command register</description>
          <addressOffset>0x008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>AXI_CMD_EN</name>
              <description>1: The command in the register is valid and it is not yet completed by the interconnect. The command and data registers are locked for any updates till this bit is reset to 0. Any write to this bit by APB master when it is already set to 1 will be ignored without any error. 0: The command register is ready to accept new commands. The data register holds the data of the last successful transaction depending on whether it was for a read or write</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AXI_RD_WR_CMD</name>
              <description>0: Read command. 1: Write command</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AXI_SOFT_RESET_BIT</name>
              <description>Internal Register reset. When this bit is set to 1 by the APB master, it resets all registers in the interconnect to their reset values. It is valid when command enable is set to 1 by the APB master. If this bit is 1 along with the command enable bit then it will execute Internal Registers Reset command irrespective of other bits value.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AXI_ERR_BIT</name>
              <description>Error Bit. This bit is a read-only bit as it is set to 1 only by the interconnect in case of error scenarios. It is valid only once command enable is reset to 0 by the interconnect. It will be cleared to 0 on next write to the command register by APB master.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AXI_MASTER_PORT</name>
              <description>Master Port ID. Identifies the master port for which command (bit[2:0]) is configured.</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AXI_RD_WR_CHAN</name>
              <description>Read Address Channel /Write Address Channel. Identifies that the command is for read address channel or write address channel of the master port (bit[11:8]). 0: the command is for read address channel. 1: the command is for write address channel. It is valid when command enable bit is set to 1 by the APB master</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AXI_CMD</name>
              <description>3'b000: BURSTINESS_REGULATOR_EN , 3'b001: PEAK_RATE_XCT_RATE , 3'b010: QOS_VALUE , 3'b011: SLV_READY</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AXI_DATA_REG</name>
          <description>Data register</description>
          <addressOffset>0x00C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>AXI_DATA</name>
              <description>Data to be written into the QoS internal register or the data read from the QoS internal register</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MPUCFG</name>
      <description>MPUCFG Controller</description>
      <baseAddress>0x20005000</baseAddress>
      <registers>
        <register>
          <name>PMPCFG_FIC0_0</name>
          <description />
          <addressOffset>0x000</addressOffset>
          <size>64</size>
          <access>read-write</access>
          <resetValue>0x000001FF</resetValue>
          <fields>
            <field>
              <name>MODE</name>
              <description>Bit 63: LOCKED When set to 1 the configuration cannot be changed until a reset occurs. Bits 62 : 61 reserved Bits 60:59: Match 00=OFF 01=TOR 10=NA4 11=NAPOT Only 00 and 11 are supported, TOR and NAT settings are equivalent to off Bit 58: Execute enable Bit 57: Write Enable Bit 56: Read Enable</description>
              <bitRange>[63:56]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PMP</name>
              <description>The PMP Value, bits 8:0 are hardwired to 9'h1ff forcing a minimum block size of 4K bytes</description>
              <bitRange>[35:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PMPCFG_FIC0_1</name>
          <description />
          <addressOffset>0x008</addressOffset>
          <size>64</size>
          <access>read-write</access>
          <resetValue>0x000001FF</resetValue>
          <fields>
            <field>
              <name>MODE</name>
              <description>Bit 63: LOCKED When set to 1 the configuration cannot be changed until a reset occurs. Bits 62 : 61 reserved Bits 60:59: Match 00=OFF 01=TOR 10=NA4 11=NAPOT Only 00 and 11 are supported, TOR and NAT settings are equivalent to off Bit 58: Execute enable Bit 57: Write Enable Bit 56: Read Enable</description>
              <bitRange>[63:56]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PMP</name>
