        </register>
        <register>
          <name>enst_on_time_q2</name>
          <description>This register sets the time period for which queue q2 is to be open, (on_time_nsec), this register has to be written according to the speed mode as:, : ||1Gbps or 2.5Gbps|| : on_time = on_time_nsec/8, : ||100Mbps|| : on_time = on_time_nsec/80, : ||10Mbps|| : on_time = on_time_nsec/800</description>
          <addressOffset>0x0828</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0001FFFF</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_17</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ON_TIME</name>
              <description>on_time, for q2</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>enst_on_time_q3</name>
          <description>This register sets the time period for which queue q3 is to be open, (on_time_nsec), this register has to be written according to the speed mode as:, : ||1Gbps or 2.5Gbps|| : on_time = on_time_nsec/8, : ||100Mbps|| : on_time = on_time_nsec/80, : ||10Mbps|| : on_time = on_time_nsec/800</description>
          <addressOffset>0x082C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0001FFFF</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_17</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ON_TIME</name>
              <description>on_time, for q3</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>enst_off_time_q0</name>
          <description>This register sets the time period for which queue q0 is to be blocked, (off_time_nsec), this register has to be written according to the speed mode as:, : ||1Gbps or 2.5Gbps|| =&gt; off_time = off_time_nsec/8, : ||100Mbps|| =&gt; off_time = off_time_nsec/80, : ||10Mbps|| =&gt; off_time = off_time_nsec/800</description>
          <addressOffset>0x0840</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_17</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>OFF_TIME</name>
              <description>Off_time, for q0</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>enst_off_time_q1</name>
          <description>This register sets the time period for which queue q1 is to be blocked, (off_time_nsec), this register has to be written according to the speed mode as:, : ||1Gbps or 2.5Gbps|| =&gt; off_time = off_time_nsec/8, : ||100Mbps|| =&gt; off_time = off_time_nsec/80, : ||10Mbps|| =&gt; off_time = off_time_nsec/800</description>
          <addressOffset>0x0844</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_17</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>OFF_TIME</name>
              <description>Off_time, for q1</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>enst_off_time_q2</name>
          <description>This register sets the time period for which queue q2 is to be blocked, (off_time_nsec), this register has to be written according to the speed mode as:, : ||1Gbps or 2.5Gbps|| =&gt; off_time = off_time_nsec/8, : ||100Mbps|| =&gt; off_time = off_time_nsec/80, : ||10Mbps|| =&gt; off_time = off_time_nsec/800</description>
          <addressOffset>0x0848</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_17</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>OFF_TIME</name>
              <description>Off_time, for q2</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>enst_off_time_q3</name>
          <description>This register sets the time period for which queue q3 is to be blocked, (off_time_nsec), this register has to be written according to the speed mode as:, : ||1Gbps or 2.5Gbps|| =&gt; off_time = off_time_nsec/8, : ||100Mbps|| =&gt; off_time = off_time_nsec/80, : ||10Mbps|| =&gt; off_time = off_time_nsec/800</description>
          <addressOffset>0x084C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_17</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>OFF_TIME</name>
              <description>Off_time, for q3</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>enst_control</name>
          <description>Enhancement for Scheduled Traffic control register. EnST scheduling can only be applied to a maximum number of 8 queues. If 802.3br operation has been configured and both an eMAC and pMAC are present then the eMAC only supports a single queue and EnST is enabled on the eMAC by writing to bit 0 of emac_enst_control.</description>
          <addressOffset>0x0880</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_8</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RESERVED_7_4</name>
              <description>Reserved.</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENST_ENABLE_Q3</name>
              <description>Set to enable enhanced scheduler traffic (ENST), for q3</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENST_ENABLE_Q2</name>
              <description>Set to enable enhanced scheduler traffic (ENST), for q2</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENST_ENABLE_Q1</name>
              <description>Set to enable enhanced scheduler traffic (ENST), for q1</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENST_ENABLE_Q0</name>
              <description>Set to enable enhanced scheduler traffic (ENST), for q0</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_timeout</name>
          <description>FRER timeout register. This determines when the sequence recovery reset timers are reset and is used by all of the configured CB streams. It is programmed as a count of 8192 rx_clk periods. 8192 rx_clk periods is 65.536 microseconds at gigabit speeds and 327.68 microseconds at 100M speeds, this allows a max timeout value of about 4 seconds at gigabit speeds - for test purposes if bit 12 (retry_test) is set in the network configuration register at 0x004 then the timeout value just becomes a count of rx_clk periods (ie a speed-up of 8192 in the time-out process).</description>
          <addressOffset>0x08A0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_16</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TIMEOUT</name>
              <description>Count of 8192 rx_clk periods.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_red_tag</name>
          <description>FRER redundancy tag register. This defines the Ethertype used to identify the R-TAG (redundancy tag) and contains a control bit to enable stripping of the R-TAG from received frames. IEEE 802.1CB has defined the value of this Ethertype to be 0xF1C1. Whether or not a particular stream uses the redundancy tag to locate the sequence number is determined by bit 28 in that streams control register.</description>
          <addressOffset>0x08A4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x4000F1C1</resetValue>
          <fields>
            <field>
              <name>STRIP_R_TAG</name>
              <description>If set the redundancy tag is stripped from received frames. If this bit is set then the receive octet counters reflect post deletion frame size so the FRER functionality is transparent to higher level management if the stripping function is enabled. If the statistics counters need to reflect the actual number of octets received, then the stripping functionality should be disabled.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SIX_BYTE_TAG</name>
              <description>Draft 2.4 and earlier drafts of the 802.1CB standard defined a four-byte redundancy tag. Drafts 2.5 and later specified a six-byte tag. Releases 1p10 and 1p11 were implemented in accordance with draft 2.4 of the standard. Set this bit to zero to inter-operate with implementations that use a four-byte tag.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_29_16</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[29:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>REDUNDANCY_TAG</name>
              <description>Ethertype value used to identify the redundancy tag (R-TAG).</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_control_1_a</name>
          <description>FRER control register A</description>
          <addressOffset>0x08C0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>EN_ELIMINATION</name>
              <description>Enable 802.1CB elimination of received frames</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_VECTOR_REC_ALG</name>
              <description>Enable 802.1CB vector recovery algorithm, : 0 enables the match recovery algorithm, : 1 enables the vector recovery algorithm, :This bit should only be changed when bit 31 en_elimination is low</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_SEQRECRST_TIMER</name>
              <description>Enable 802.1CB sequence recovery reset timer - this bit may be changed when bit 31 en_elimination is low</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USE_R_TAG</name>
              <description>Set to one to use redundancy tag to identify sequence number otherwise use offset value to identify bottom of sequence number - this bit should only be changed when bit 31 en_elimination is low</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_27_17</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[27:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>OFFSET_VALUE</name>
              <description>Offset value in bytes from the start packet delimiter to the most significant byte of the 802.1CB sequence number - 9 bits allow a maximum value of 511 - allowing a TCP sequence number to be used with IPv6 - this bit should only be changed when en_elimination is low</description>
              <bitRange>[16:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MEMBER_STREAM_2</name>
              <description>Pointer to screener type 2 register used for member stream identification. The member stream 1 and 2 values may be programmed to identical values. - this bit should only be changed when en_elimination is low</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MEMBER_STREAM_1</name>
              <description>Pointer to screener type 2 register used for member stream identification. The member stream 1 and 2 values may be programmed to identical values. - this bit should only be changed when en_elimination is low</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_control_1_b</name>
          <description>FRER control register B. This register has default values where the sequence number length defaults to 16 and the vector recovery window defaults to the size of the history vector. It is not expected that the user will need to change these default values.</description>
          <addressOffset>0x08C4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_13</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:13]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SEQ_NUM_LENGTH</name>
              <description>Number of significant bits of the 802.1CB sequence number. The value 0x00 or numbers greater than 16 bits are equivalent to 16, but the number written will still be read back if it is greater than 16. If a value of less than 16 is written, then the sequence recovery algorithm will only consider that number of LSBs of the sequence number. The minimum size of seq_num_length has to be such that 2^seq_num_len is at least 2xgem_seq_history_len otherwise the vector recovery algorithm will not work correctly - this bit should only be changed when en_elimination is low</description>
              <bitRange>[12:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_7_6</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[7:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SEQ_REC_WINDOW</name>
              <description>Vector recovery window, defines the window size used by the vector recovery algorithm to determine whether to reject a packet. Six bits allow a window size of 63, for effective operation of FRER users should not write a value greater than the gem_seq_history_len configuration define, a value of zero means the entire history vector is used - this bit should only be changed when en_elimination is low.</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_statistics_1_a</name>
          <description>FRER statistics register A. This register is cleared on a read and does not roll over if its maximum value is reached.</description>
          <addressOffset>0x08C8</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_26</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:26]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>VEC_REC_ROGUE</name>
              <description>Count of number of frames dropped by the vector recovery algorithm for being out of range</description>
              <bitRange>[25:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_15_10</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[15:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>LATENT_ERRORS</name>
              <description>Count of sequence numbers seen without a duplicate. The latent error count is updated when a frame is dropped from the history vector. So the update only happens after a new frame is received.</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_statistics_1_b</name>
          <description>FRER statistics register B. This register is cleared on a read and does not roll over if its maximum value is reached.</description>
          <addressOffset>0x08CC</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_24</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SEQRST_COUNT</name>
              <description>Count of number of times the sequence recovery reset timer decrements to zero.</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_15_10</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[15:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>OUT_OF_ORDER</name>
              <description>Count of out of order sequence numbers received. Incremented when a frame is accepted but the sequence number is not +1 of the highest stored value.</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_control_2_a</name>
          <description>FRER control register A</description>
          <addressOffset>0x08D0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>EN_ELIMINATION</name>
              <description>Enable 802.1CB elimination of received frames</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_VECTOR_REC_ALG</name>
              <description>Enable 802.1CB vector recovery algorithm, : 0 enables the match recovery algorithm, : 1 enables the vector recovery algorithm, :This bit should only be changed when bit 31 en_elimination is low</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_SEQRECRST_TIMER</name>
              <description>Enable 802.1CB sequence recovery reset timer - this bit may be changed when bit 31 en_elimination is low</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USE_R_TAG</name>
              <description>Set to one to use redundancy tag to identify sequence number otherwise use offset value to identify bottom of sequence number - this bit should only be changed when bit 31 en_elimination is low</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_27_17</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[27:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>OFFSET_VALUE</name>
              <description>Offset value in bytes from the start packet delimiter to the most significant byte of the 802.1CB sequence number - 9 bits allow a maximum value of 511 - allowing a TCP sequence number to be used with IPv6 - this bit should only be changed when en_elimination is low</description>
              <bitRange>[16:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MEMBER_STREAM_2</name>
              <description>Pointer to screener type 2 register used for member stream identification. The member stream 1 and 2 values may be programmed to identical values. - this bit should only be changed when en_elimination is low</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MEMBER_STREAM_1</name>
              <description>Pointer to screener type 2 register used for member stream identification. The member stream 1 and 2 values may be programmed to identical values. - this bit should only be changed when en_elimination is low</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_control_2_b</name>
          <description>FRER control register B. This register has default values where the sequence number length defaults to 16 and the vector recovery window defaults to the size of the history vector. It is not expected that the user will need to change these default values.</description>
          <addressOffset>0x08D4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_13</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:13]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SEQ_NUM_LENGTH</name>
              <description>Number of significant bits of the 802.1CB sequence number. The value 0x00 or numbers greater than 16 bits are equivalent to 16, but the number written will still be read back if it is greater than 16. If a value of less than 16 is written, then the sequence recovery algorithm will only consider that number of LSBs of the sequence number. The minimum size of seq_num_length has to be such that 2^seq_num_len is at least 2xgem_seq_history_len otherwise the vector recovery algorithm will not work correctly - this bit should only be changed when en_elimination is low</description>
              <bitRange>[12:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_7_6</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[7:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SEQ_REC_WINDOW</name>
              <description>Vector recovery window, defines the window size used by the vector recovery algorithm to determine whether to reject a packet. Six bits allow a window size of 63, for effective operation of FRER users should not write a value greater than the gem_seq_history_len configuration define, a value of zero means the entire history vector is used - this bit should only be changed when en_elimination is low.</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>frer_statistics_2_a</name>
          <description>FRER statistics register A. This register is cleared on a read and does not roll over if its maximum value is reached.</description>
          <addressOffset>0x08D8</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_26</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:26]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>VEC_REC_ROGUE</name>
              <description>Count of number of frames dropped by the vector recovery algorithm for being out of range</description>
              <bitRange>[25:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
