              <access>read-only</access>
            </field>
            <field>
              <name>TX_TOO_MANY_RETRIES_MASK</name>
              <description>Mask bit for too many retry attempts after collision error (half duplex only).</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RX_UDP_CK_ERR_MASK</name>
              <description>Mask bit for RX packet UDP checksum error.</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RX_TCP_CK_ERR_MASK</name>
              <description>Mask bit for RX packet TCP checksum error.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RX_IP_CK_ERR_MASK</name>
              <description>Mask bit for RX packet IP checksum error.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RX_LENGTH_ERR_MASK</name>
              <description>Mask bit for RX packet with length field error.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RX_SYMBOL_ERR_MASK</name>
              <description>Mask bit for RX packet with symbol errors.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RX_LONG_ERR_MASK</name>
              <description>Mask bit for RX packet too long.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RX_SHORT_ERR_MASK</name>
              <description>Mask bit for RX packet too short.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RX_CRC_ERR_MASK</name>
              <description>Mask bit for RX packet with bad CRC.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
