              <name>ENABLE_SUSPENDM</name>
              <description>Enable SuspendM signal output</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SUSPEND_MODE</name>
              <description>USB suspend mode active (read-only)</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RESUME_SIGNAL</name>
