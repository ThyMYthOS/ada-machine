        <register>
          <name>axi_qos_cfg_0</name>
          <description>AXI Quality of Service register 0. This register is only present if AXI is configured. This register contains 8-bits per queue to control driving of the ARQOS and AWQOS outputs (4-bits each). For each queue the lower four bits are for data accesses and the upper four bits are for descriptor accesses.</description>
          <addressOffset>0x02E0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>Q_3_DESCR_QOS</name>
              <description>Determines what value to drive to the ARQOS and AWQOS outputs (4-bits each) for queue 3 descriptor accesses.</description>
              <bitRange>[31:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Q_3_DATA_QOS</name>
              <description>Determines what value to drive to the ARQOS and AWQOS outputs (4-bits each) for queue 3 data accesses.</description>
              <bitRange>[27:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Q_2_DESCR_QOS</name>
              <description>Determines what value to drive to the ARQOS and AWQOS outputs (4-bits each) for queue 2 descriptor accesses.</description>
              <bitRange>[23:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Q_2_DATA_QOS</name>
              <description>Determines what value to drive to the ARQOS and AWQOS outputs (4-bits each) for queue 2 data accesses.</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Q_1_DESCR_QOS</name>
              <description>Determines what value to drive to the ARQOS and AWQOS outputs (4-bits each) for queue 1 descriptor accesses.</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Q_1_DATA_QOS</name>
              <description>Determines what value to drive to the ARQOS and AWQOS outputs (4-bits each) for queue 1 data accesses.</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Q_0_DESCR_QOS</name>
              <description>Determines what value to drive to the ARQOS and AWQOS outputs (4-bits each) for queue 0 descriptor accesses.</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Q_0_DATA_QOS</name>
              <description>Determines what value to drive to the ARQOS and AWQOS outputs (4-bits each) for queue 0 data accesses.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>int_q1_status</name>
          <description>Priority Queue Interrupt Status Register</description>
          <addressOffset>0x0400</addressOffset>
          <size>32</size>
