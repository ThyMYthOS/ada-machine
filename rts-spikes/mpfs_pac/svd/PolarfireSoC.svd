    <peripheral derivedFrom="GPIO_IOBANK0_LO">
      <name>GPIO_IOBANK1_LO</name>
      <description>GPIO_IOBANK1_LO Controller</description>
      <baseAddress>0x20121000</baseAddress>
    </peripheral>
    <peripheral derivedFrom="GPIO_IOBANK0_LO">
      <name>GPIO_FAB_LO</name>
      <description>GPIO_FAB_LO Controller</description>
      <baseAddress>0x20122000</baseAddress>
    </peripheral>
    <peripheral>
      <name>MSRTC_LO</name>
      <description>MSRTC_LO Controller</description>
      <baseAddress>0x20124000</baseAddress>
      <registers>
        <register>
          <name>CONTROL_REG</name>
          <description />
          <addressOffset>0x000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>UPDATED</name>
              <description>1:when RTC counter updates the RTC value.It is cleared by the writing '1' to the bit</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WAKEUP_SET</name>
              <description>1:Assert the rtc_wakeup output and set the wakeup status bit.</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WAKEUP_CLEAR</name>
              <description>Set every time a match occurs.1:wakeup_clear bit is cleared. Once cleared it will not be set again until the next wakeup occurs</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MATCH</name>
              <description>RTC value matches with wakeup value. Indicates rtc_match output value.</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DOWNLOAD</name>
              <description>1: Current RTC counter value to be downloaded</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>UPLOAD</name>
              <description>1: Date/time value loaded into date/time registers and uploaded to the RTC counters</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESET</name>
              <description>1:date/time value is reset and uploaded to RTC counters</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ALARM_OFF</name>
              <description>1:Alarm is disabled</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ALARM_ON</name>
              <description>1:Alarm is enabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>STOP</name>
              <description>When stop bit is written '1', RTC counter is stopped. Read indicates that RTC is running</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>START</name>
              <description>When start bit is written '1',indicates that RTC counter is started. Read indicates that RTC counter is running.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MODE_REG</name>
          <description />
          <addressOffset>0x004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>WAKE_RESET_PS</name>
              <description>when a wakeup occurs reset the pre-scaler</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WAKE_CONTINUE</name>
              <description>when a wakeup occurs continue counting</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WAKE_RESET</name>
              <description>when a wakeup occurs reset the RTC counters</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WAKE_ENABLE</name>
              <description>Enables the wakeup output</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CLOCK_MODE</name>
              <description>0: Binary counter 1: date and time counting</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PRESCALER_REG</name>
          <description />
          <addressOffset>0x008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PRESCALER</name>
              <description>value to divide incoming rtc clock. It should be set to achieve 1Hz from rtc_clk. Value must be greater than 1. Value = Clock Frequency - 1Hz</description>
              <bitRange>[25:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ALARM_LOWER_REG</name>
          <description />
          <addressOffset>0x00C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ALARM_LOWER</name>
              <description>Write: Sets the alarm wakeup time. Read: Returns the alarm time. Binary count [31:0]</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ALARM_UPPER_REG</name>
          <description />
          <addressOffset>0x010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ALARM_UPPER</name>
              <description>Write: sets the alarm wakeup time. Read: returns the alarm time. Binary count [42:32]</description>
              <bitRange>[10:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMPARE_LOWER_REG</name>
          <description />
          <addressOffset>0x014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>COMPARE_LOWER</name>
              <description>Write: sets the compare bits on the alarm time. [7:0]: Seconds, [15:8]: Minutres, [23:16]: Hours, [31:24]:Day. Read: Returns the compare value. 0: Bit is ignored. 1: Bit is compared.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMPARE_UPPER_REG</name>
          <description />
          <addressOffset>0x018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>COMPARE_UPPER</name>
              <description>Write: sets the compare bits on the alarm time. [7:0]: Month, [15:8]: Year, [23:16]: Weekday, [29:24]:Week. Read: Returns the compare value. 0: Bit is ignored. 1: Bit is compared.</description>
              <bitRange>[29:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DATE_TIME_LOWER_REG</name>
          <description />
          <addressOffset>0x020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATETIME_LOWER</name>
              <description>Writes: Data to be uploaded to counter. Read: returns the current time. [7:0]: Seconds, [15:8]: Minutres, [23:16]: Hours, [31:24]:Day.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DATE_TIME_UPPER_REG</name>
          <description />
          <addressOffset>0x024</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATETIME_UPPER</name>
              <description>Writes: Data to be uploaded to counter. Read: returns the upper time bits that are in alignment with the last read lower bits.[7:0]: Month, [15:8]: Year, [23:16]: Weekday, [29:24]:Week.</description>
              <bitRange>[29:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SECONDS_REG</name>
          <description />
          <addressOffset>0x030</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SECONDS</name>
              <description>The complete RTC data is read and stored internally. For writes all fields (0x30-x4c) must be written. The control register upload bit will upload data to the RTC.These registers are for use when clock_mode=1</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MINUTES_REG</name>
          <description />
          <addressOffset>0x034</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MINUTES</name>
              <description />
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HOURS_REG</name>
          <description />
          <addressOffset>0x038</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>HOURS</name>
              <description />
              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DAY_REG</name>
          <description />
          <addressOffset>0x03C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DAY</name>
              <description />
              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MONTH_REG</name>
          <description />
          <addressOffset>0x040</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MONTH</name>
              <description />
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>YEAR_REG</name>
          <description />
          <addressOffset>0x044</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>YEAR</name>
              <description />
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WEEKDAY_REG</name>
          <description />
          <addressOffset>0x048</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>WEEKDAY</name>
              <description />
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WEEK_REG</name>
          <description />
          <addressOffset>0x04C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>WEEK</name>
              <description />
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SECONDS_CNT_REG</name>
          <description />
          <addressOffset>0x050</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SECONDS</name>
              <description>Each read returns the current date/time value. It is possible that date/time may increament b/w reads. Write: All fields (0x50-0x6c) must be writeen. The control register upload bit will upload the data to RTC.These registers are for use when clock_mode=1</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MINUTES_CNT_REG</name>
          <description />
          <addressOffset>0x054</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MINUTES</name>
              <description />
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HOURS_CNT_REG</name>
          <description />
          <addressOffset>0x058</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>HOURS</name>
              <description />
              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DAY_CNT_REG</name>
          <description />
          <addressOffset>0x05C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DAY</name>
              <description />
              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MONTH_CNT_REG</name>
          <description />
          <addressOffset>0x060</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MONTH</name>
              <description />
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>YEAR_CNT_REG</name>
          <description />
          <addressOffset>0x064</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>YEAR</name>
              <description />
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WEEKDAY_CNT_REG</name>
          <description />
          <addressOffset>0x068</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>WEEKDAY</name>
              <description />
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WEEK_CNT_REG</name>
          <description />
          <addressOffset>0x06C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>WEEK</name>
