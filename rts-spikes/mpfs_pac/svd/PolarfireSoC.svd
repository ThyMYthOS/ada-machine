              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>IO_BANK_B2_STATUS</name>
              <description>Power status of IO bank 2</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>FLASH_VALID</name>
              <description>Indicates the status of the flash_valid input from G5 Control.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>FF_IN_PROGRESS</name>
              <description>Indicates the status of the ff_in_progress input from G5 Control.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>LP_STATE</name>
              <description>Indicates the status of the lp_state input from G5 Control.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>CORE_UP</name>
              <description>Indicates the status of the core_up input from G5 Control.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
