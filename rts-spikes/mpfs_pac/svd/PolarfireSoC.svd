          <name>FAB_INTEN_MISC</name>
          <description>Allows the Ethernat interrupts to be directly routed to the U54 CPUS.</description>
          <addressOffset>0x050</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MAC1_U54_4</name>
              <description>Enables the Ethernet MAC1 to interrupt U54_1 directly</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MAC1_U54_3</name>
              <description>Enables the Ethernet MAC1 to interrupt U54_1 directly</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MAC0_U54_2</name>
              <description>Enables the Ethernet MAC0 to interrupt U54_1 directly</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MAC0_U54_1</name>
