        <register>
          <name>TRACE_CR</name>
          <description>Configures the trace and debug connectivity</description>
          <addressOffset>0x1B8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ULTRASOC_FABRIC</name>
              <description>When set the Utrasoc JTAG interface is connected to fabric EIP connections allowing the JTAG to be directly accessed through fabric IO pins. This also connects the RiscV debugger to the fabric as it passed through the UltraSoc JPAM module</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ULTRASOC_DISABLE_AXI</name>
              <description>When set the Utrasoc module is dissabled and will not respond to AXI accesses from PF-Control or the fabric. The JTAG end point will be in bypass mode.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ULTRASOC_DISABLE_JTAG</name>
              <description>When set the Utrasoc module is dissabled and will not respond to JTAG accesses from PF-Control or the fabric. The JTAG end point will be in bypass mode.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CPU_DEBUG_DISABLE</name>
              <description>When set the RiscV debug module is dissabled and will not respond to JTAG accesses from either PF-Control or the fabric. The JTAG end point will be in bypass mode.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MSSIO_CONTROL_CR</name>
          <description>Controls the MSS Corner IO control signals</description>
          <addressOffset>0x1BC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000720</resetValue>
          <fields>
            <field>
              <name>MSS_SEL_HW_DEF</name>
              <description>Sets the value driven out on mss_sel_hw_def_out</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MSS_SEL_HW_DYN</name>
              <description>Sets the value driven out on mss_sel_hw_dyn_out</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MSS_IO_EN</name>
              <description>Sets the value driven out on mss_io_en (before gating)</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MSS_FLASH_VALID</name>
              <description>Sets the value driven out on mss_flash_valid_out</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MSS_CORE_UP</name>
              <description>Sets the value driven out on mss_core_up_out</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MSS_DCE</name>
              <description>Sets the value driven out on mss_dce_out unless PFC asserts its overrides</description>
