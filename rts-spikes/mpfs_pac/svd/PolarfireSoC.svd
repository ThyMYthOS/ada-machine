            </field>
            <field>
              <name>GEM_NUM_CB_STREAMS</name>
              <description>Takes the value of the 'gem_no_of_cb_streams DEFINE or 0x01 if undefined or the defined value is zero.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
