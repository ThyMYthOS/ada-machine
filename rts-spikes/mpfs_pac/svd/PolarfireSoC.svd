              <description>CINT_SE - Card Interrupt Status Enable

 1 - enabled
 0 - masked</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CR_SE</name>
              <description>CR_SE - Card Removal Status Enable

 1 - enabled
