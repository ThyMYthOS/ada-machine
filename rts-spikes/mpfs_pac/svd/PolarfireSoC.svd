          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RX_MSG14_ACR</name>
              <description>Receive Message14 buffer ACR bits [31:3]: Identifier [2]: IDE [1]: RTR [0]: N/A</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
