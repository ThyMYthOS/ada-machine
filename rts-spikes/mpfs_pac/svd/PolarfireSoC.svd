              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FIC2</name>
              <description>Bit is set on violation. Cleared by writing '1'</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FIC1</name>
              <description>Bit is set on violation. Cleared by writing '1'</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FIC0</name>
              <description>Bit is set on violation. Cleared by writing '1'</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
