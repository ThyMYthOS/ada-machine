          <name>RX_MSG23_AMR_DATA</name>
          <description>AMR- Data</description>
          <addressOffset>0x518</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RX_MSG23_AMR_DATA</name>
              <description>Receive Message23 buffer AMR Data bits [15:8]: CAN data byte 1 [7:0]: CAN data byte 2</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RX_MSG23_ACR_DATA</name>
          <description>ACR- Data</description>
