      </registers>
    </peripheral>
    <peripheral>
      <name>CRYPTO</name>
      <description>CRYPTO Controller</description>
      <baseAddress>0x20127000</baseAddress>
      <registers>
        <register>
          <name>CONFIG</name>
          <description />
          <addressOffset>0x0000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <fields>
            <field>
              <name>FAB_OWNER</name>
              <description>Fabric controls the crypto block</description>
              <bitRange>[29:29]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>MSS_OWNER</name>
              <description>MSS controls the crypto block</description>
              <bitRange>[28:28]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>FAB_RELEASE</name>
              <description>Fabric has released the crypto, see the MSS/Fabric Crypto block ownership section in the MAS specification</description>
              <bitRange>[27:27]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>FAB_REQUEST</name>
              <description>Fabric is requesting crypto use, see the MSS/Fabric Crypto block ownership section in the MAS specification</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MSS_RELEASE</name>
              <description>MSS releases crypto, see the MSS/Fabric Crypto block ownership section in the MAS specification</description>
              <bitRange>[25:25]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>MSS_REQUEST</name>
              <description>MSS requests crypto use, see the MSS/Fabric Crypto block ownership section in the MAS specification</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USE_FAB_CLK</name>
              <description>When '1' in MSS mode the Crypto core and AHB interconnect is clocked by the Fabric clock rather than by the MSS sourced 200MHz clock source. This allows the MSS to use the AHB interfaces and the Fabric the streaming interface.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_1</name>
              <description />
              <bitRange>[15:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>STREAM_ENABLED</name>
              <description>Indicates that the streaming interface ie enabled</description>
              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>BUSERROR</name>
              <description>Status signal from Athena core indicating it received a AHB bus error response</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ALARM</name>
              <description>Status signal from Athena core indicating alarm condition</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>COMPLETE</name>
              <description>Status signal from Athena core indicating complete</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>STALL_RATE</name>
              <description>Sets the average stall rate. 00: 1 in 8 01: 1 in 16 10: 1 in 32 11: 1 in 64</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>STALL_ENABLE</name>
              <description>Enables the stall system on the Crypto core 0: Operates in G5 mode using fabric stall signal, clock_select must be 01 1: Internal mode enabled, stall occurrence generated internally on average 1 in 8 clocks. Works with clock_select 01 or 11.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>STREAM_ENABLE</name>
              <description>Enables the streaming interface to the fabric, must also be enabled via SCB device register</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RING_OSC_ON</name>
              <description>Turns on the Athena ring oscillators, note turned off at reset</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>GO</name>
              <description>Asserts the Athena go input</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PURGE</name>
              <description>Asserts the Athena purge command input</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESET</name>
              <description>Asserts the internal Athena core reset signal</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>STALL</name>
          <description />
          <addressOffset>0x0004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SEED</name>
              <description>Sets the seed value used in the generation off the Athena Stall logic</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UPPER_ADDRESS</name>
          <description />
          <addressOffset>0x0008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Sets the upper 6-bits of the 38 bit Master address provided to the MSS.</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>USB</name>
      <description>MSS USB 2.0 OTG High-Speed Controller</description>
      <baseAddress>0x20201000</baseAddress>
      <registers>
        <register>
          <name>FADDR</name>
          <description>Function Address Register (peripheral mode)</description>
          <addressOffset>0x000</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FUNC_ADDR</name>
              <description>USB function address (0–127)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>POWER</name>
          <description>Power Management and High-Speed Control Register</description>
