          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CQDQS</name>
              <description>CQDQS - Device Queue Status

 This register reflects to eMMC device status. Task N is ready for execution when bit N in this register is set to 1. This register is updated each time response for SEND_QUEUE_STATUS (CMD13) is received.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CQRS13</name>
          <description>CQRS13 - Device Pending Tasks
 This register information which task is submitted to eMMC (CMD44 and CMD45 was sent) and is not executed. Task N is submitted and not executed when N bit is set 1. Bit N is cleared when task N is completed.</description>
