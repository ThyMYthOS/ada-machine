        <register>
          <name>enst_on_time_q0</name>
          <description>This register sets the time period for which queue q0 is to be open, (on_time_nsec), this register has to be written according to the speed mode as:, : ||1Gbps or 2.5Gbps|| : on_time = on_time_nsec/8, : ||100Mbps|| : on_time = on_time_nsec/80, : ||10Mbps|| : on_time = on_time_nsec/800</description>
          <addressOffset>0x0820</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0001FFFF</resetValue>
          <fields>
            <field>
              <name>RESERVED_31_17</name>
              <description>Reserved, read as 0, ignored on write.</description>
              <bitRange>[31:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ON_TIME</name>
              <description>on_time, for q0</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>enst_on_time_q1</name>
          <description>This register sets the time period for which queue q1 is to be open, (on_time_nsec), this register has to be written according to the speed mode as:, : ||1Gbps or 2.5Gbps|| : on_time = on_time_nsec/8, : ||100Mbps|| : on_time = on_time_nsec/80, : ||10Mbps|| : on_time = on_time_nsec/800</description>
