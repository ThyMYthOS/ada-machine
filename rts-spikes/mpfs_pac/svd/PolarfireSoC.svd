              <name>CFG_DQ_WIDTH</name>
              <description>Variable DQ width. 0 - Full-Width 1 - Half-Width 2 - Quarter-Width</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CFG_ACTIVE_DQ_SEL</name>
