        <register>
          <name>STATUS_FIC0</name>
          <description />
          <addressOffset>0x080</addressOffset>
          <size>64</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>FAILED</name>
              <description>Indicates Failure occurred, cleared via a system register bit</description>
              <bitRange>[43:43]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ID</name>
              <description>AXI ID of failure (4-bits)</description>
              <bitRange>[42:39]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WRITE</name>
              <description>0=Read 1=Write</description>
              <bitRange>[38:38]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ADDRESS</name>
              <description>38-bit failed address</description>
              <bitRange>[37:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
