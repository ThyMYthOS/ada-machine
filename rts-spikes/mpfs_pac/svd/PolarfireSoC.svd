          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>HENABLE</name>
              <description>Enables individual H2F outputs</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>GENABLE</name>
              <description>Enables all the H2FINT outputs</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>H2FSTATUS</name>
          <description />
          <addressOffset>0x004</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>H2FSTATUS</name>
              <description>Read back of the 16-bit H2F Interrupts before the H2F and global enable</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PLSTATUS0</name>
          <description />
          <addressOffset>0x010</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PLSTATUS0</name>
              <description>Indicates that the PLINT interrupt is active before the PLINT enable i.e. direct read of the PLINT inputs [31:0]</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PLSTATUS1</name>
          <description />
          <addressOffset>0x014</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PLSTATUS1</name>
              <description>Indicates that the PLIT interrupt is active before the PLINT enable i.e. direct read of the PLINT inputs [63:32]</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PLSTATUS2</name>
          <description />
          <addressOffset>0x018</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PLSTATUS2</name>
              <description>Indicates that the PLIT interrupt is active before the PLINT enable i.e. direct read of the PLINT inputs [95:64]</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PLSTATUS3</name>
          <description />
          <addressOffset>0x01C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PLSTATUS3</name>
              <description>Indicates that the PLINT interrupt is active before the PLINT enable i.e. direct read of the PLINT inputs [127:96]</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PLENABLE0</name>
          <description />
          <addressOffset>0x020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PLENABLE0</name>
              <description>Enables PLINT interrupts 31:0</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
