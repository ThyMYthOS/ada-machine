          <description />
          <addressOffset>0x04420</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000008</resetValue>
          <fields>
            <field>
              <name>MT_ADDR_BITS</name>
              <description>Address range to test. Test will start at 'mt_start_addr' and continue to addresses 'mt_start_addr' + 2 ^ mt_addr_bits. Note: The minimum valid value is a function of memory burst length: 1 - (memory burst length = 2) 2 - (memory burst length = 4) 3 - (memory burst length = 8)</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
