    <peripheral>
      <name>CFG_DDR_SGMII_PHY</name>
      <description>CFG_DDR_SGMII_PHY Controller</description>
      <baseAddress>0x20007000</baseAddress>
      <registers>
        <register>
          <name>SOFT_RESET_DDR_PHY</name>
          <description>Compulsory register for all SCB slaves, facilitating global soft reset.</description>
