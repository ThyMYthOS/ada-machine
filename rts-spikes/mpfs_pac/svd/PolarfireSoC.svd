          <name>SPARE_REGISTER_RW</name>
          <description>Register for ECO usage</description>
          <addressOffset>0x2D0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
