          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PHY_INDPNDT_TRAINING</name>
              <description>Set to 1'b1 to indicate that the PHY will perform training without requiring interaction from the MC. The PHY will start training at the assertion of ctrlr_init_done and will signal completion with dfi_training_complete.</description>
