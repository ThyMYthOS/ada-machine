              <name>ERSP_IE</name>
              <description>ERSP_IE - Response Error Interrupt Enable

 1 - enabled
 0 - masked</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EADMA_IE</name>
              <description>EADMA_IE - ADMA Error Interrupt Enable (SD mode only)

 1 - enabled
 0 - masked</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EAC_IE</name>
              <description>EAC_IE - Auto CMD Error Interrupt Enable (SD mode only)

 1 - enabled
 0 - masked</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ECL_IE</name>
              <description>ECL_IE - Current Limit Error Interrupt Enable (SD mode only)

 1 - enabled
 0 - masked</description>
              <bitRange>[23:23]</bitRange>
