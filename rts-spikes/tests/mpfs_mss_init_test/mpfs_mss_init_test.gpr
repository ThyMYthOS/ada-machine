with "runtime_build.gpr";
with "target_options.gpr";
with "mpfs_pac.gpr";
with "config/mpfs_mss_init_test_config.gpr";

project Mpfs_Mss_Init_Test is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("mpfs_mss_init_test.adb");

   --  E51 has no FPU (hart 0, Harts_Mask => 1): renaming, not restating,
   --  so this application cannot disagree with the soft-float ABI the
   --  runtime crate derives from Harts_Mask (same pattern as
   --  clock_switch_e51.gpr).
   package Builder renames Target_Options.Builder;

   package Linker is
      for Switches ("Ada") use
        Runtime_Build.Linker_Switches & Runtime_Build.Defsyms
        & ("-Wl,--gc-sections");
   end Linker;
end Mpfs_Mss_Init_Test;
