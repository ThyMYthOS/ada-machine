with "runtime_build.gpr";
with "ravenscar_build.gpr";
with "target_options.gpr";
with "config/tasking_mpfs_config.gpr";

project Tasking_MPFS is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tasking_mpfs.adb");

   --  The ABI comes from the runtime crate, derived once from the hart
   --  mask. Renaming rather than restating keeps libgnat, libgnarl and
   --  this application on one decision (avrada_rts's pattern; only the
   --  ROOT project's Builder is honoured, hence the rename here).
   package Builder renames Target_Options.Builder;

   package Linker is
      for Switches ("Ada") use
        Runtime_Build.Linker_Switches & Runtime_Build.Defsyms
        & ("-Wl,--gc-sections");
   end Linker;
end Tasking_MPFS;
