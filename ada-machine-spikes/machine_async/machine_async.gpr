with "../machine/machine.gpr";
with "config/machine_async_config.gpr";
project Machine_Async is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        Machine_Async_Config.Ada_Compiler_Switches;
   end Compiler;
end Machine_Async;
