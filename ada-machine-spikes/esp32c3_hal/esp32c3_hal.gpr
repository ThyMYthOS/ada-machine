with "../machine/machine.gpr";
with "../esp32c3_pac/esp32c3_pac.gpr";
with "config/esp32c3_hal_config.gpr";
project ESP32C3_HAL is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        Esp32c3_Hal_Config.Ada_Compiler_Switches;
   end Compiler;
end ESP32C3_HAL;
