with "../machine/machine.gpr";
with "../machine_async/machine_async.gpr";
with "../machine_blocking/machine_blocking.gpr";
with "../machine_regmap/machine_regmap.gpr";
with "../bme280/bme280.gpr";
with "../atmega328p_hal/atmega328p_hal.gpr";
with "../avrada_rts/avrada_rts.gpr";
with "../avrada_rts/avr_tool_options.gpr";
with "config/spike2_avr_config.gpr";
with "../test_support/test_mode.gpr";

project Spike2_AVR is
   for Target use "avr";
   for Runtime ("Ada") use "../avrada_rts";

   --  alire.toml's [configuration.variables] BME280_BUS documents this
   --  switch and is what a depending crate's [configuration.values] would
   --  override -- but Alire bakes that into config/spike2_avr_config.gpr
   --  as a plain literal, regenerated fresh each build, which a `-X` on
   --  the command line can't reach. Re-declaring it here as its own
   --  external(), defaulting to the same value, keeps
   --  `alr build -- -XBME280_BUS=I2C` working for anyone building this
   --  crate directly (this repo's own Makefile uses exactly that).
   type Bus_Kind is ("SPI", "I2C");
   Bus : Bus_Kind := external ("BME280_BUS", "SPI");

   --  "src" (shared) has the one bus-agnostic main.adb, calling
   --  AVR_Board.Setup for whichever variant's own "src/spi"/"src/i2c"
   --  supplies it. Object_Dir/Exec_Dir still vary per Bus, not just
   --  Source_Dirs: both variants declare a same-named "Avr_Board" unit
   --  with a different body, and sharing one Object_Dir let a stale
   --  gnatprove/gprbuild cache from one variant corrupt analysis of the
   --  other after a bare `-X` switch with no `rm -rf obj` in between.
   --  Test mode (ADA_MACHINE_TEST_MODE, see ../test_support/test_mode.gpr):
   --  both bus variants share one test_off/test_on pair (AVR_Board is the
   --  same name in both). Halt: cli + sleep.
   Test_Dirs := ();
   case Test_Mode.Mode is
      when "off" =>
         Test_Dirs := ("test_off");
      when "on" =>
         Test_Dirs := ("test_on", "../test_support/common",
                       "../test_support/halt_avr");
   end case;

   case Bus is
      when "SPI" =>
         for Source_Dirs use ("src", "src/spi", "config") & Test_Dirs;
         for Object_Dir use "obj/spi" & Test_Mode.Dir_Suffix;
         for Exec_Dir use "bin/spi" & Test_Mode.Dir_Suffix;
      when "I2C" =>
         for Source_Dirs use ("src", "src/i2c", "config") & Test_Dirs;
         for Object_Dir use "obj/i2c" & Test_Mode.Dir_Suffix;
         for Exec_Dir use "bin/i2c" & Test_Mode.Dir_Suffix;
   end case;

   for Main use ("main.adb");

   package Builder is
      --  gprbuild otherwise names the binary "main" (after the source
      --  file); alire.toml's executables/"alr run" expect "spike2_avr".
      for Executable ("main.adb") use "spike2_avr";

      --  ATmega328P has 32KB flash; unoptimized (-O0), checks-enabled Ada
      --  code -- even with avrada_rts itself built for size (§10) -- does
      --  not fit. -Os/-gnatp here match avrada_rts's own Production
      --  profile default and apply across the whole closure (HAL/PAC/
      --  machine*/bme280 sources too, not just this crate's own), which
      --  a per-project Compiler'Default_Switches would not.
      --  -mmcu: without it the closure was compiled for the generic avr2
      --  core (no MUL, no device defines) while avrada_rts itself uses the
      --  real device; avrada_rts's AVR_Tool_Options carries the MCU name.
      for Global_Compilation_Switches ("Ada") use
        ("-Os", "-gnatp", "-mmcu=" & AVR_Tool_Options.MCU);
   end Builder;

   --  Link with avrada_rts's own linker switches (AVR_Tool_Options): above
   --  all -mmcu, which selects the ATmega328P's startup file (vector table,
   --  .data/.bss init) and linker script (32 KB flash). Without it the link
   --  was generic avr2 -- no vector table at all, so machine_async's SPI
   --  interrupt could never have been dispatched -- with an 8 KB text limit.
   package Linker is
      for Switches ("Ada") use AVR_Tool_Options.Linker_Switches;
   end Linker;

   --  Target ("avr") and Runtime ("Ada") come from avrada_rts.gpr itself
   --  (it declares both for its own project directory, §10); "with"ing
   --  it above is enough to make the whole closure build against the
   --  real AVR cross-compiler instead of the native host GNAT.
end Spike2_AVR;
