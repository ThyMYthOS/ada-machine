with "../machine/machine.gpr";
with "../rp2040_pac/rp2040_pac.gpr";
with "config/rp2040_hal_config.gpr";
project RP2040_HAL is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        Rp2040_Hal_Config.Ada_Compiler_Switches;
   end Compiler;
end RP2040_HAL;
