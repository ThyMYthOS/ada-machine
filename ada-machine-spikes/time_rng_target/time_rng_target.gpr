with "../machine/machine.gpr";
with "config/time_rng_target_config.gpr";
project Time_RNG_Target is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        Time_Rng_Target_Config.Ada_Compiler_Switches;
   end Compiler;
end Time_RNG_Target;
