with "../machine/machine.gpr";
with "../machine_blocking/machine_blocking.gpr";
with "../machine_regmap/machine_regmap.gpr";
with "../bme280/bme280.gpr";
with "../rp2040_hal/rp2040_hal.gpr";
with "config/spike1_pico_config.gpr";
with "../test_support/test_mode.gpr";

project Spike1_Pico is
   --  Test mode (ADA_MACHINE_TEST_MODE, see ../test_support/test_mode.gpr):
   --  test_off/ is the normal build's no-op Test_Run; test_on/ wires the
   --  shared runner (host stand-in halt: a plain loop).
   case Test_Mode.Mode is
      when "off" =>
         for Source_Dirs use ("src", "config", "test_off");
      when "on" =>
         for Source_Dirs use ("src", "config", "test_on",
                              "../test_support/common",
                              "../test_support/halt_host");
   end case;
   for Object_Dir use "obj" & Test_Mode.Dir_Suffix;
   for Main use ("main.adb");
   for Exec_Dir use "bin" & Test_Mode.Dir_Suffix;

   package Builder is
      --  gprbuild otherwise names the binary "main" (after the source
      --  file); alire.toml's executables/"alr run" expect "spike1_pico".
      for Executable ("main.adb") use "spike1_pico";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        Spike1_Pico_Config.Ada_Compiler_Switches;
   end Compiler;

   --  A real build inherits Runtime ("Ada") from a light_rp2040-style
   --  runtime crate (§10, §16) and a linker script from that crate's
   --  board layer; both are out of scope for this environment (no
   --  cross toolchain available -- see host_test for what IS run).
end Spike1_Pico;
