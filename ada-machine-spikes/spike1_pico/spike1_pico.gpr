with "../machine/machine.gpr";
with "../machine_blocking/machine_blocking.gpr";
with "../machine_regmap/machine_regmap.gpr";
with "../bme280/bme280.gpr";
with "../rp2040_hal/rp2040_hal.gpr";

project Spike1_Pico is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main.adb");
   for Exec_Dir use "bin";

   package Builder is
      --  gprbuild otherwise names the binary "main" (after the source
      --  file); alire.toml's executables/"alr run" expect "spike1_pico".
      for Executable ("main.adb") use "spike1_pico";
   end Builder;

   --  A real build inherits Runtime ("Ada") from a light_rp2040-style
   --  runtime crate (§10, §16) and a linker script from that crate's
   --  board layer; both are out of scope for this environment (no
   --  cross toolchain available -- see host_test for what IS run).
end Spike1_Pico;
