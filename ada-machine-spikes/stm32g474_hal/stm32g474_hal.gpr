with "../machine/machine.gpr";
with "../stm32g474_pac/stm32g474_pac.gpr";
with "config/stm32g474_hal_config.gpr";
project STM32G474_HAL is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        Stm32g474_Hal_Config.Ada_Compiler_Switches;
   end Compiler;
end STM32G474_HAL;
