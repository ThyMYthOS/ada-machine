with "../machine/machine.gpr";
with "../atmega328p_pac/atmega328p_pac.gpr";
with "config/atmega328p_hal_config.gpr";
project ATmega328P_HAL is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        Atmega328p_Hal_Config.Ada_Compiler_Switches;
   end Compiler;
end ATmega328P_HAL;
