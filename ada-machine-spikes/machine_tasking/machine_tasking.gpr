with "../machine/machine.gpr";
with "../machine_async/machine_async.gpr";
with "../machine_blocking/machine_blocking.gpr";
with "config/machine_tasking_config.gpr";

project Machine_Tasking is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        Machine_Tasking_Config.Ada_Compiler_Switches;
   end Compiler;
end Machine_Tasking;
