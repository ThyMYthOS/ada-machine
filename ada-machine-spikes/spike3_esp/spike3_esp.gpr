with "../machine/machine.gpr";
with "../machine_tasking/machine_tasking.gpr";
with "../machine_regmap/machine_regmap.gpr";
with "../bme280/bme280.gpr";
with "../esp32c3_hal/esp32c3_hal.gpr";
with "config/spike3_esp_config.gpr";
with "../test_support/test_mode.gpr";

project Spike3_ESP is
   --  Test mode (ADA_MACHINE_TEST_MODE, see ../test_support/test_mode.gpr).
   --  Host stand-in halt for now; switch to ../test_support/halt_riscv
   --  once this is linked for the ESP32-C3.
   case Test_Mode.Mode is
      when "off" =>
         for Source_Dirs use ("src", "config", "test_off");
      when "on" =>
         for Source_Dirs use ("src", "config", "test_on",
                              "../test_support/common",
                              "../test_support/halt_host");
   end case;
   for Object_Dir use "obj" & Test_Mode.Dir_Suffix;
   for Main use ("main.adb");
   for Exec_Dir use "bin" & Test_Mode.Dir_Suffix;

   package Builder is
      --  gprbuild otherwise names the binary "main" (after the source
      --  file); alire.toml's executables/"alr run" expect "spike3_esp".
      for Executable ("main.adb") use "spike3_esp";
      --  §6.6: machine_tasking targets the Ravenscar/Jorvik SPARK subset
      --  (protected objects, suspension objects) -- GNATprove requires
      --  the profile to actually be declared for tasking constructs to
      --  be legal SPARK (SPARK RM 9(2)), so it's not implied merely by
      --  using them. A real cross build would get this from the target
      --  runtime's own restricted profile instead of a local .adc.
      for Global_Configuration_Pragmas use "ravenscar.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        Spike3_Esp_Config.Ada_Compiler_Switches;
   end Compiler;

   --  A real build inherits Runtime ("Ada") from a light-tasking runtime
   --  for ESP32-C3 (RV32IMC); no such crate exists yet, here or upstream
   --  (§10's runtime-compatibility gate for machine_tasking) -- out of
   --  scope here, same as spike1_pico/spike2_avr never cross-building
   --  (no toolchain for their targets in this environment either; see
   --  host_test for what IS run).
end Spike3_ESP;
