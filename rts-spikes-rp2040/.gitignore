# Runtime sources are copied by populate.sh, never committed (README.md
# "Blockers"/rts-spikes/CONTRACT.md §1).
rts_sources_gcc15_arm/libgnat/
rts_sources_gcc15_arm/libgnarl/
rts_sources_gcc15_arm/libgnat-armv6m/
rts_sources_gcc15_arm/libgnat-armv8m/
rts_core_cortexm/src/
rts_support_rp2040/src/
rts_support_rp2040/ld/*.ld
*/obj/
*/obj-*/
*/adalib/
*/adalib-*/
*/bin/
*/alire/
*/gnat_config/

# gnat_config/ holds ONLY Alire-generated output, regenerated from
# [configuration.variables] on every build. The hand-written
# pico_runtime_config.ads shim lives in src/ precisely so that generated and
# authored files are never mixed in one directory.
light_tasking_pico/gnat_config/light_tasking_pico_config.*

# Populated runtime sources are reproducible via populate.sh and not
# committed. The leaf-owned units we edited or that need tracking are exempted
# below.
light_tasking_pico/src/*.ad[bs]
!light_tasking_pico/src/pico_runtime_config.ads
!light_tasking_pico/src/s-bbpara.ads
#  pico_config_checks.ads is hand-authored -- the Device validation unit whose
#  Compile_Time_Error was verified to fire. Without this negation the blanket
#  pattern above silently drops it, which is the same defect the PolarFire spike
#  hit with mpfs_config_checks.ads (rts-spikes/CONTRACT.md §7.12).
!light_tasking_pico/src/pico_config_checks.ads

#  Alire regenerates every crate's config/ directory on each build.
*/config/

# Stray compiler output from verification probes
*.ali
*.o
ada_target_properties
